<section class="wm-home wm-home__section" aria-labelledby="WaymeloReviewsTitle-{{ section.id }}">
  <div class="wm-home__shell">
    <div class="wm-home__section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="wm-home__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="wm-home__heading" id="WaymeloReviewsTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>

    <div class="wm-review-grid" data-wm-swipe aria-label="Customer reviews">
      {%- for block in section.blocks -%}
        {%- liquid
          assign review_image = block.settings.image
          if review_image == blank and block.settings.product != blank
            assign review_image = block.settings.product.featured_image
          endif
          assign review_image_alt = block.settings.image_alt | default: review_image.alt | default: block.settings.heading
        -%}
        <article class="wm-review-card" {{ block.shopify_attributes }}>
          <div class="wm-review-card__media">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: class: 'wm-review-card__video', image_size: '900x', autoplay: false, loop: false, muted: false, controls: true, preload: 'none' }}
            {%- elsif review_image != blank -%}
              {{
                review_image
                | image_url: width: 900
                | image_tag:
                  class: 'wm-review-card__image',
                  widths: '320, 480, 640, 900',
                  sizes: '(min-width: 990px) 31vw, 82vw',
                  loading: 'lazy',
                  alt: review_image_alt
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="wm-review-card__body">
            <div class="wm-review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for star in (1..5) -%}{% if star <= block.settings.rating %}★{% else %}☆{% endif %}{%- endfor -%}
            </div>
            <h3 class="wm-review-card__title">{{ block.settings.heading | escape }}</h3>
            <div class="wm-review-card__quote">{{ block.settings.quote }}</div>
            <div class="wm-review-card__author">{{ block.settings.author | escape }}{% if block.settings.product_name != blank %} · {{ block.settings.product_name | escape }}{% endif %}</div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Waymelo reviews",
  "tag": "section",
  "class": "section-waymelo-reviews",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From their journeys." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "video", "id": "video", "label": "Customer video" },
        { "type": "image_picker", "id": "image", "label": "Customer photo or video cover" },
        { "type": "product", "id": "product", "label": "Fallback product image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Comfort on the go" },
        { "type": "richtext", "id": "quote", "label": "Review", "default": "<p>Add a genuine customer review here.</p>" },
        { "type": "text", "id": "author", "label": "Customer name", "default": "Verified customer" },
        { "type": "text", "id": "product_name", "label": "Product purchased" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Waymelo reviews",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }]
    }
  ]
}
{% endschema %}

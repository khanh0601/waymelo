  © BlockyApps. You are permitted to use this content within your store. Redistribution or use in any other application is strictly prohibited.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign logo_src = s.logo_url
  if s.logo != blank
    assign logo_src = s.logo | image_url: width: 400
  endif
  assign current_year = 'now' | date: '%Y'
  assign copyright = s.copyright_text | replace: '{year}', current_year
-%}

{% style %}
  .blocky-ft-{{ section.id }} {
    border-top: {{ section.settings.border_top_width }}px solid {{ section.settings.border_color }};
  }
  .blocky-ft-{{ section.id }} .blocky-page-width { padding-left: {{ section.settings.side_padding }}px; padding-right: {{ section.settings.side_padding }}px; }

  .blocky-ft-{{ section.id }}__cols {
    display: grid;
    grid-template-columns: auto auto auto;
    justify-content: space-between;
    column-gap: {{ section.settings.columns_gap }}px;
    row-gap: {{ section.settings.columns_gap }}px;
    align-items: start;
  }

  .blocky-ft-{{ section.id }}__logo {
    display: block;
    width: {{ section.settings.logo_width }}px;
    height: auto;
    max-width: 100%;
    object-fit: contain;
    margin: 0 0 {{ section.settings.logo_bottom_gap }}px 0;
  }

  .blocky-ft-{{ section.id }}__payments {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: {{ section.settings.icons_gap }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .blocky-ft-{{ section.id }}__payments img {
    display: block;
    width: {{ section.settings.icon_size }}px;
    height: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .blocky-ft-{{ section.id }}__heading {
    margin: 0 0 {{ section.settings.content_gap }}px 0;
    font-family: {{ section.settings.heading_font_family }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: {{ section.settings.line_height }};
    color: {{ section.settings.heading_color }};
    text-transform: capitalize;
  }

  .blocky-ft-{{ section.id }}__line {
    margin: 0 0 {{ section.settings.content_gap }}px 0;
    max-width: {{ section.settings.contact_width }}px;
    font-family: {{ section.settings.body_font_family }};
    font-size: {{ section.settings.body_size }}px;
    font-weight: 400;
    line-height: {{ section.settings.line_height }};
    color: {{ section.settings.body_color }};
  }
  .blocky-ft-{{ section.id }}__line:last-child { margin-bottom: 0; }

  .blocky-ft-{{ section.id }}__links { margin: 0; padding: 0; list-style: none; }
  .blocky-ft-{{ section.id }}__links li { margin: 0 0 {{ section.settings.link_gap }}px 0; }
  .blocky-ft-{{ section.id }}__links li:last-child { margin-bottom: 0; }
  .blocky-ft-{{ section.id }}__links a {
    display: inline-block;
    font-family: {{ section.settings.body_font_family }};
    font-size: {{ section.settings.body_size }}px;
    font-weight: 400;
    line-height: {{ section.settings.line_height }};
    color: {{ section.settings.link_color }};
    text-decoration: none;
  }
  .blocky-ft-{{ section.id }}__links a:hover { opacity: 0.7; }

  .blocky-ft-{{ section.id }}__divider {
    width: 100%;
    height: 0;
    border-top: {{ section.settings.divider_width }}px solid {{ section.settings.divider_color }};
    margin-top: {{ section.settings.divider_top_gap }}px;
    margin-bottom: {{ section.settings.divider_bottom_gap }}px;
  }

  .blocky-ft-{{ section.id }}__copyright {
    margin: 0;
    padding: 0 {{ section.settings.side_padding }}px;
    text-align: center;
    font-family: {{ section.settings.body_font_family }};
    font-size: {{ section.settings.copyright_size }}px;
    font-weight: 400;
    line-height: {{ section.settings.line_height }};
    color: {{ section.settings.copyright_color }};
  }

  @media screen and (max-width: 749px) {
    .blocky-ft-{{ section.id }}__cols {
      grid-template-columns: 1fr;
      row-gap: {{ section.settings.mobile_columns_gap }}px;
      justify-content: start;
    }
    .blocky-ft-{{ section.id }}__logo { width: {{ section.settings.mobile_logo_width }}px; }
    .blocky-ft-{{ section.id }}__payments { gap: {{ section.settings.mobile_icons_gap }}px; }
    .blocky-ft-{{ section.id }}__payments img { width: {{ section.settings.mobile_icon_size }}px; }
    .blocky-ft-{{ section.id }}__heading { font-size: {{ section.settings.mobile_heading_size }}px; }
    .blocky-ft-{{ section.id }}__line,
    .blocky-ft-{{ section.id }}__links a { font-size: {{ section.settings.mobile_body_size }}px; }
    .blocky-ft-{{ section.id }}__copyright { font-size: {{ section.settings.mobile_copyright_size }}px; }
    .blocky-ft-{{ section.id }}__divider { margin-top: {{ section.settings.mobile_divider_top_gap }}px; }
  }
{% endstyle %}

<div
  class="blocky blocky-footer blocky-ft-{{ section.id }} blocky-padding background-wrapper"
  style="--padding-top: {{ section.settings.padding_top }}; --padding-bottom: {{ section.settings.padding_bottom }}; --background-color: {{ section.settings.background_color }}; --section-page-width: {{ section.settings.page_width | divided_by: 10 }}rem;"
>
  <div class="blocky-page-width">
    <div class="blocky-ft-{{ section.id }}__cols">
      <div class="blocky-ft-{{ section.id }}__brand">
        {%- if logo_src != blank -%}
          <img
            class="blocky-ft-{{ section.id }}__logo"
            src="{{ logo_src }}"
            alt="{{ section.settings.logo_alt | escape }}"
            width="{{ section.settings.logo_width }}"
            height="{{ section.settings.logo_width }}"
            loading="lazy"
          >
        {%- endif -%}
        {%- assign payment_blocks = section.blocks | where: 'type', 'payment' -%}
        {%- if payment_blocks.size > 0 -%}
          <ul class="blocky-ft-{{ section.id }}__payments">
            {%- for block in payment_blocks -%}
              {%- liquid
                assign icon_src = block.settings.image_url
                if block.settings.image != blank
                  assign icon_src = block.settings.image | image_url: width: 200
                endif
              -%}
              {%- if icon_src != blank -%}
                <li {{ block.shopify_attributes }}>
                  <img
                    src="{{ icon_src }}"
                    alt="{{ block.settings.image_alt | escape }}"
                    width="{{ section.settings.icon_size }}"
                    height="{{ section.settings.icon_size }}"
                    loading="lazy"
                  >
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="blocky-ft-{{ section.id }}__contact">
        {%- if section.settings.contact_title != blank -%}
          <p class="blocky-ft-{{ section.id }}__heading">{{ section.settings.contact_title }}</p>
        {%- endif -%}
        {%- if section.settings.contact_line_1 != blank -%}
          <p class="blocky-ft-{{ section.id }}__line">{{ section.settings.contact_line_1 }}</p>
        {%- endif -%}
        {%- if section.settings.contact_line_2 != blank -%}
          <p class="blocky-ft-{{ section.id }}__line">{{ section.settings.contact_line_2 }}</p>
        {%- endif -%}{%- if section.settings.contact_line_3 != blank -%}
          <p class="blocky-ft-{{ section.id }}__line">{{ section.settings.contact_line_3 }}</p>
        {%- endif -%}
      </div>

      <div class="blocky-ft-{{ section.id }}__policies">
        {%- if section.settings.policies_title != blank -%}
          <p class="blocky-ft-{{ section.id }}__heading">{{ section.settings.policies_title }}</p>
        {%- endif -%}
        {%- assign link_blocks = section.blocks | where: 'type', 'link' -%}
        {%- if link_blocks.size > 0 -%}
          <ul class="blocky-ft-{{ section.id }}__links">
            {%- for block in link_blocks -%}
              {%- liquid
                assign href = block.settings.link_url
                if block.settings.link != blank
                  assign href = block.settings.link
                endif
              -%}
              <li {{ block.shopify_attributes }}>
                <a href="{{ href | default: '#' }}">{{ block.settings.label }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="blocky-ft-{{ section.id }}__divider"></div>

  {%- if copyright != blank -%}
    <p class="blocky-ft-{{ section.id }}__copyright">{{ copyright }}</p>
  {%- endif -%}
</div>


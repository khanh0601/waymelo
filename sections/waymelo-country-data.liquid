{%- comment -%}
  Country list for the localization selector. Not rendered in the layout any more;
  assets/localization-form.js fetches it on demand through the Section Rendering API
  (/?sections=waymelo-country-data) the first time a selector is opened.
{%- endcomment -%}
{%- if localization.available_countries.size > 1 -%}
  {%- assign waymelo_popular_country_codes = localization.available_countries | where: 'popular?' | map: 'iso_code' -%}
  <script id="WaymeloCountryData" type="application/json">
    {"countries":[
      {%- for country in localization.available_countries -%}
        {
          "iso": {{ country.iso_code | json }},
          "name": {{ country.name | json }},
          "currencyCode": {{ country.currency.iso_code | json }},
          "currencySymbol": {{ country.currency.symbol | json }},
          "popular": {%- if waymelo_popular_country_codes contains country.iso_code -%}true{%- else -%}false{%- endif -%}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]}
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Waymelo country data",
  "settings": []
}
{% endschema %}

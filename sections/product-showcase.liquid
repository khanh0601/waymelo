{%- liquid
  # Lazy HTML: for real visitors the whole section ships inside an inert <template>, so its
  # scripts, stylesheets and media do nothing until the loader in layout/theme.liquid activates
  # it (when the section comes within ~1200px of the viewport). Rendered normally in the theme
  # editor and when the section sits at the top of a page (section.index <= 2). Only sections
  # without SEO value use this.
  assign waymelo_lazy_html = true
  if request.design_mode
    assign waymelo_lazy_html = false
  endif
  if section.index == blank or section.index <= 2
    assign waymelo_lazy_html = false
  endif
-%}
{%- if waymelo_lazy_html -%}
  <div data-waymelo-lazy-placeholder style="min-height: 600px" aria-hidden="true"></div>
  <template data-waymelo-lazy-section>
{%- endif -%}
{%- liquid
  assign waymelo_css_eager = false
  if section.index == blank or section.index <= 2
    assign waymelo_css_eager = true
  endif
-%}
{% render 'waymelo-lazy-css', files: 'section-product-showcase.css,component-card.css,component-price.css,quick-add.css,waymelo-collection.css,waymelo-quick-choose.css', eager: waymelo_css_eager %}
{%- if request.page_type == 'product' -%}
  <template data-waymelo-lazy-script data-src="{{ 'product-form.js' | asset_url }}"></template>
  <template data-waymelo-lazy-script data-src="{{ 'quick-add.js' | asset_url }}"></template>
  <template data-waymelo-lazy-script data-src="{{ 'waymelo-quick-choose.js' | asset_url }}"></template>
{%- else -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'waymelo-quick-choose.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign showcase_products = section.settings.products
  if showcase_products == blank
    assign showcase_products = section.settings.collection.products
  endif
-%}

<section
  class="product-showcase waymelo-collection-products color-{{ section.settings.color_scheme }} gradient"
  style="
    --showcase-columns: {{ section.settings.columns_desktop }};
    --showcase-columns-mobile: {{ section.settings.columns_mobile }};
    --showcase-mobile-card-width: {% if section.settings.columns_mobile == '2' %}calc(50% - 0.6rem){% else %}86%{% endif %};
    --showcase-padding-top: {{ section.settings.padding_top }}px;
    --showcase-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="product-showcase__inner page-width">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="product-showcase__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="product-showcase__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="product-showcase__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="product-showcase__grid product-grid" role="list">
      {%- assign skip_card_product_styles = false -%}
      {%- for showcase_product in showcase_products limit: section.settings.products_to_show -%}
        <article class="product-showcase__card grid__item" role="listitem">
          {% render 'card-product',
            card_product: showcase_product,
            media_aspect_ratio: 'square',
            image_shape: 'default',
            show_secondary_image: true,
            show_vendor: false,
            show_rating: true,
            lazy_load: true,
            skip_styles: skip_card_product_styles,
            section_id: section.id,
            quick_add: 'standard',
            use_variant_popup: true
          %}
        </article>
        {%- assign skip_card_product_styles = true -%}
      {%- else -%}
        {%- for i in (1..section.settings.columns_desktop) -%}
          {%- assign placeholder_image = 'product-' | append: i -%}
          <article class="product-showcase__card grid__item" role="listitem">
            {% render 'card-product', placeholder_image: placeholder_image %}
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all and section.settings.collection != blank -%}
      <div class="product-showcase__view-all">
        <a href="{{ section.settings.collection.url }}" class="product-showcase__view-all-link">
          {{ section.settings.view_all_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{%- if waymelo_lazy_html -%}
  </template>
{%- endif -%}

{% schema %}
{
  "name": "Product showcase",
  "tag": "section",
  "class": "section-product-showcase",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover our latest products and fresh new designs.</p>"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "info": "Selected products take priority over the collection.",
      "limit": 12
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Maximum products",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop columns",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Product showcase"
    }
  ]
}
{% endschema %}

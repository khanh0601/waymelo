{%- liquid
  # The eyebrow and heading are `richtext` settings, so their stored value can
  # carry markup (`<p>`, `<strong>`, `<a>`) a merchant applies in the editor.
  # Render it as inline content only: drop the `<p>` wrapper Shopify adds around
  # a stored body so the `<p>`/`<h2>` below keeps a valid, single-block outline.
  assign faq_eyebrow = section.settings.eyebrow | remove: '<p>' | remove: '</p>'
  assign faq_heading = section.settings.heading | remove: '<p>' | remove: '</p>'
-%}
<section class="wm-home wm-home__section" aria-labelledby="WaymeloFaqTitle-{{ section.id }}">
  <div class="wm-home__shell wm-faq">
    <div class="wm-faq__intro">
      {%- if faq_eyebrow != blank -%}<p class="wm-home__eyebrow">{{ faq_eyebrow }}</p>{%- endif -%}
      <h2 class="wm-home__heading" id="WaymeloFaqTitle-{{ section.id }}">{{ faq_heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="wm-faq__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="wm-home__text-link" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>
      {%- endif -%}
    </div>

    <div class="wm-faq__items">
      {%- for block in section.blocks -%}
        <details class="wm-faq__item" data-wm-faq-item{% if block.settings.open_by_default %} open{% endif %} {{ block.shopify_attributes }}>
          <summary class="wm-faq__question" data-wm-faq-summary>{{ block.settings.question | escape }}</summary>
          <div class="wm-faq__answer" data-wm-faq-answer>{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.enable_faq_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | strip_newlines | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | strip_newlines | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Waymelo FAQ",
  "tag": "section",
  "class": "section-waymelo-faq",
  "max_blocks": 12,
  "settings": [
    { "type": "richtext", "id": "eyebrow", "label": "Eyebrow", "default": "<p>A little help before you go</p>" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Good to know.</p>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A few things to help you find your next essential.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get in touch" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "enable_faq_schema", "label": "Enable FAQ structured data", "default": true }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What can I find at Waymelo?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Practical essentials for life on the go.</p>" },
        { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Waymelo FAQ",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}

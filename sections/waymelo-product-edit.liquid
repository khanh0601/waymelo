{%- liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank
    assign featured_collection = collections.all
  endif

  assign has_product_blocks = false
  for block in section.blocks
    if block.type == 'product' and block.settings.product != blank
      assign has_product_blocks = true
      break
    endif
  endfor

  assign source = section.settings.source
  if source == 'manual' or has_product_blocks
    assign use_blocks = true
  elsif source == 'product_list' and section.settings.product_list != blank and section.settings.product_list.count > 0
    assign use_product_list = true
  else
    assign use_collection = true
  endif

  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank
    if featured_collection != blank and featured_collection.url != blank
      assign view_all_url = featured_collection.url
    else
      assign view_all_url = routes.all_products_collection_url
    endif
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;
  }

  #WaymeloProductEdit-{{ section.id }} .wm-product-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 28px);
  }

  {%- if section.settings.header_alignment == 'center' -%}
    #WaymeloProductEdit-{{ section.id }} .wm-home__section-head {
      flex-direction: column;
      align-items: center;
      text-align: center;
      justify-content: center;
      gap: 16px;
    }
    #WaymeloProductEdit-{{ section.id }} .wm-home__section-head > div {
      text-align: center;
    }
  {%- endif -%}

  .wm-product-card__vendor {
    font-size: 1.15rem;
    color: #776e7d;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }

  .wm-home__description {
    margin: 10px 0 0;
    color: #554e5b;
    font-size: 1.45rem;
    line-height: 1.6;
    max-width: 650px;
  }

  {%- if section.settings.enable_mobile_slider -%}
    @media screen and (max-width: 749px) {
      #WaymeloProductEdit-{{ section.id }} .wm-product-grid {
        display: flex;
        overflow-x: auto;
        padding-bottom: 14px;
        scroll-padding-inline: 16px;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
        gap: 14px;
      }
      #WaymeloProductEdit-{{ section.id }} .wm-product-grid::-webkit-scrollbar {
        display: none;
      }
      #WaymeloProductEdit-{{ section.id }} .wm-product-card {
        flex: 0 0 {% if section.settings.columns_mobile == '2' %}45%{% else %}80%{% endif %};
        scroll-snap-align: start;
      }
    }
  {%- else -%}
    @media screen and (max-width: 749px) {
      #WaymeloProductEdit-{{ section.id }} .wm-product-grid {
        display: grid;
        grid-template-columns: repeat({{ section.settings.columns_mobile | default: 1 }}, minmax(0, 1fr));
        gap: 16px;
      }
      #WaymeloProductEdit-{{ section.id }} .wm-product-card {
        flex: none;
      }
    }
  {%- endif -%}
{%- endstyle -%}

<section
  id="WaymeloProductEdit-{{ section.id }}"
  class="wm-home wm-home__section wm-products section-{{ section.id }}-padding"
  aria-labelledby="WaymeloProductsTitle-{{ section.id }}"
>
  <div class="wm-home__shell">
    <div class="wm-home__section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="wm-home__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="wm-home__heading" id="WaymeloProductsTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="wm-home__description">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all -%}
        <a class="wm-home__text-link" href="{{ view_all_url }}">
          {{ section.settings.view_all_label | escape }} <span aria-hidden="true">↗</span>
        </a>
      {%- endif -%}
    </div>

    <div
      class="wm-product-grid"
      {% if section.settings.enable_mobile_slider %}data-wm-swipe{% endif %}
      aria-label="{{ section.settings.heading | default: 'Products' | escape }}"
    >
      {%- if use_blocks -%}
        {%- assign rendered_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'product' and block.settings.product != blank -%}
            {%- assign product = block.settings.product -%}
            {%- assign custom_badge = block.settings.custom_badge -%}
            {%- assign product_image_alt = product.featured_image.alt | default: product.title -%}
            {%- liquid
              assign badge_text = custom_badge
              if badge_text == blank and section.settings.show_tag
                if product.compare_at_price > product.price
                  assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
                  assign badge_text = 'Save ' | append: savings | append: '%'
                endif

                for tag in product.tags
                  assign tag_downcase = tag | downcase
                  if tag_downcase == 'bestseller' or tag_downcase == 'best-seller' or tag_downcase == 'best seller'
                    assign badge_text = 'Bestseller'
                    break
                  elsif tag_downcase == 'new' or tag_downcase == 'trending'
                    assign badge_text = tag | capitalize
                    break
                  elsif tag_downcase contains 'badge:'
                    assign badge_text = tag | split: ':' | last | strip
                    break
                  endif
                endfor
              endif
            -%}
            <a class="wm-product-card" href="{{ product.url }}" {{ block.shopify_attributes }}>
              <div class="wm-product-card__media">
                {%- if product.featured_image != blank -%}
                  {{
                    product.featured_image
                    | image_url: width: 1000
                    | image_tag:
                      class: 'wm-product-card__image wm-product-card__image--primary',
                      widths: '320, 480, 640, 800, 1000',
                      sizes: '(min-width: 990px) 31vw, (min-width: 750px) 50vw, 100vw',
                      loading: 'lazy',
                      alt: product_image_alt
                  }}
                  {%- if product.media.size > 1 and section.settings.show_secondary_image -%}
                    {{
                      product.media[1]
                      | image_url: width: 1000
                      | image_tag:
                        class: 'wm-product-card__image wm-product-card__image--secondary',
                        widths: '320, 480, 640, 800, 1000',
                        sizes: '(min-width: 990px) 31vw, (min-width: 750px) 50vw, 100vw',
                        loading: 'lazy',
                        alt: product_image_alt
                    }}
                  {%- endif -%}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
                {%- if badge_text != blank and section.settings.show_tag -%}
                  <span class="wm-product-card__badge">{{ badge_text | escape }}</span>
                {%- endif -%}
              </div>
              <div class="wm-product-card__info">
                <div class="wm-product-card__text-group">
                  {%- if section.settings.show_vendor and product.vendor != blank -%}
                    <div class="wm-product-card__vendor">{{ product.vendor | escape }}</div>
                  {%- endif -%}
                  <h3 class="wm-product-card__title">{{ product.title | escape }}</h3>
                  {%- if section.settings.show_rating -%}
                    {% render 'card-product-rating', product: product, link: false %}
                  {%- endif -%}
                </div>
                <span class="wm-product-card__price">
                  {%- if product.compare_at_price > product.price -%}
                    <s class="wm-product-card__compare">{{ product.compare_at_price | money }}</s>
                  {%- endif -%}
                  {{ product.price | money }}
                </span>
              </div>
            </a>
            {%- assign rendered_count = rendered_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- elsif use_product_list -%}
        {%- for product in section.settings.product_list limit: section.settings.products_to_show -%}
          {%- assign product_image_alt = product.featured_image.alt | default: product.title -%}
          {%- liquid
            assign badge_text = ''
            if section.settings.show_tag
              if product.compare_at_price > product.price
                assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
                assign badge_text = 'Save ' | append: savings | append: '%'
              endif

              for tag in product.tags
                assign tag_downcase = tag | downcase
                if tag_downcase == 'bestseller' or tag_downcase == 'best-seller' or tag_downcase == 'best seller'
                  assign badge_text = 'Bestseller'
                  break
                elsif tag_downcase == 'new' or tag_downcase == 'trending'
                  assign badge_text = tag | capitalize
                  break
                elsif tag_downcase contains 'badge:'
                  assign badge_text = tag | split: ':' | last | strip
                  break
                endif
              endfor
            endif
          -%}
          <a class="wm-product-card" href="{{ product.url }}">
            <div class="wm-product-card__media">
              {%- if product.featured_image != blank -%}
                {{
                  product.featured_image
                  | image_url: width: 1000
                  | image_tag:
                    class: 'wm-product-card__image wm-product-card__image--primary',
                    widths: '320, 480, 640, 800, 1000',
                    sizes: '(min-width: 990px) 31vw, (min-width: 750px) 50vw, 100vw',
                    loading: 'lazy',
                    alt: product_image_alt
                }}
                {%- if product.media.size > 1 and section.settings.show_secondary_image -%}
                  {{
                    product.media[1]
                    | image_url: width: 1000
                    | image_tag:
                      class: 'wm-product-card__image wm-product-card__image--secondary',
                      widths: '320, 480, 640, 800, 1000',
                      sizes: '(min-width: 990px) 31vw, (min-width: 750px) 50vw, 100vw',
                      loading: 'lazy',
                      alt: product_image_alt
                  }}
                {%- endif -%}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              {%- if badge_text != blank and section.settings.show_tag -%}
                <span class="wm-product-card__badge">{{ badge_text | escape }}</span>
              {%- endif -%}
            </div>
            <div class="wm-product-card__info">
              <div class="wm-product-card__text-group">
                {%- if section.settings.show_vendor and product.vendor != blank -%}
                  <div class="wm-product-card__vendor">{{ product.vendor | escape }}</div>
                {%- endif -%}
                <h3 class="wm-product-card__title">{{ product.title | escape }}</h3>
                {%- if section.settings.show_rating -%}
                  {% render 'card-product-rating', product: product, link: false %}
                {%- endif -%}
              </div>
              <span class="wm-product-card__price">
                {%- if product.compare_at_price > product.price -%}
                  <s class="wm-product-card__compare">{{ product.compare_at_price | money }}</s>
                {%- endif -%}
                {{ product.price | money }}
              </span>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
          {%- assign product_image_alt = product.featured_image.alt | default: product.title -%}
          {%- liquid
            assign badge_text = ''
            if section.settings.show_tag
              if product.compare_at_price > product.price
                assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
                assign badge_text = 'Save ' | append: savings | append: '%'
              endif

              for tag in product.tags
                assign tag_downcase = tag | downcase
                if tag_downcase == 'bestseller' or tag_downcase == 'best-seller' or tag_downcase == 'best seller'
                  assign badge_text = 'Bestseller'
                  break
                elsif tag_downcase == 'new' or tag_downcase == 'trending'
                  assign badge_text = tag | capitalize
                  break
                elsif tag_downcase contains 'badge:'
                  assign badge_text = tag | split: ':' | last | strip
                  break
                endif
              endfor
            endif
          -%}
          <a class="wm-product-card" href="{{ product.url }}">
            <div class="wm-product-card__media">
              {%- if product.featured_image != blank -%}
                {{
                  product.featured_image
                  | image_url: width: 1000
                  | image_tag:
                    class: 'wm-product-card__image wm-product-card__image--primary',
                    widths: '320, 480, 640, 800, 1000',
                    sizes: '(min-width: 990px) 31vw, (min-width: 750px) 50vw, 100vw',
                    loading: 'lazy',
                    alt: product_image_alt
                }}
                {%- if product.media.size > 1 and section.settings.show_secondary_image -%}
                  {{
                    product.media[1]
                    | image_url: width: 1000
                    | image_tag:
                      class: 'wm-product-card__image wm-product-card__image--secondary',
                      widths: '320, 480, 640, 800, 1000',
                      sizes: '(min-width: 990px) 31vw, (min-width: 750px) 50vw, 100vw',
                      loading: 'lazy',
                      alt: product_image_alt
                  }}
                {%- endif -%}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              {%- if badge_text != blank and section.settings.show_tag -%}
                <span class="wm-product-card__badge">{{ badge_text | escape }}</span>
              {%- endif -%}
            </div>
            <div class="wm-product-card__info">
              <div class="wm-product-card__text-group">
                {%- if section.settings.show_vendor and product.vendor != blank -%}
                  <div class="wm-product-card__vendor">{{ product.vendor | escape }}</div>
                {%- endif -%}
                <h3 class="wm-product-card__title">{{ product.title | escape }}</h3>
                {%- if section.settings.show_rating -%}
                  {% render 'card-product-rating', product: product, link: false %}
                {%- endif -%}
              </div>
              <span class="wm-product-card__price">
                {%- if product.compare_at_price > product.price -%}
                  <s class="wm-product-card__compare">{{ product.compare_at_price | money }}</s>
                {%- endif -%}
                {{ product.price | money }}
              </span>
            </div>
          </a>
        {%- else -%}
          {%- for index in (1..section.settings.columns_desktop) -%}
            <div class="wm-product-card">
              <div class="wm-product-card__media">{{ 'product-' | append: index | placeholder_svg_tag: 'placeholder-svg' }}</div>
              <div class="wm-product-card__info">
                <div class="wm-product-card__text-group">
                  <h3 class="wm-product-card__title">Product title</h3>
                </div>
                <span class="wm-product-card__price">{{ 5999 | money }}</span>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Waymelo product edit",
  "tag": "section",
  "class": "section-waymelo-products",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Waymelo edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your next go-to essentials."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "Shop all essentials"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Custom view all link"
    },
    {
      "type": "header",
      "content": "Product source"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Product source",
      "options": [
        { "value": "collection", "label": "From collection" },
        { "value": "product_list", "label": "From product list" },
        { "value": "manual", "label": "From individual blocks" }
      ],
      "default": "collection",
      "info": "Choose how you want to select products for this section"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Product list",
      "limit": 16
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 1,
      "max": 16,
      "step": 1,
      "label": "Maximum products to show",
      "default": 3
    },
    {
      "type": "header",
      "content": "Grid & Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop (1, 2, 3, or 4)",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_slider",
      "label": "Enable swipe carousel on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Product card options"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tag",
      "label": "Show curated badge (Save %, Bestseller)",
      "default": true
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "custom_badge",
          "label": "Custom badge label (optional)",
          "info": "Leave blank to auto-calculate discount percentage"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Waymelo product edit",
      "settings": {
        "columns_desktop": 3,
        "columns_mobile": "1",
        "products_to_show": 3
      }
    }
  ]
}
{% endschema %}

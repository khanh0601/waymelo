{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* =========================================================================
     CONTAINER SYNCHRONIZATION WITH LUXURY HEADER:
     Exact 1360px max-width & 36px desktop padding (20px mobile)
     ========================================================================= */
  .section-{{ section.id }}-padding .page-width,
  .atelier-collection-toolbar.page-width,
  .facets-vertical.page-width,
  .collection.page-width {
    max-width: 1360px !important;
    width: 100% !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding-left: 36px !important;
    padding-right: 36px !important;
    box-sizing: border-box !important;
  }

  @media screen and (max-width: 1023px) {
    .section-{{ section.id }}-padding .page-width,
    .atelier-collection-toolbar.page-width,
    .facets-vertical.page-width,
    .collection.page-width {
      padding-left: 20px !important;
      padding-right: 20px !important;
    }
  }

  /* =========================================================================
     ATELIER COLLECTION TOOLBAR & SIDEBAR FILTERS (Luxury Screenshot Styling)
     ========================================================================= */
  .atelier-collection-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #e8e4dc;
    border-bottom: 1px solid #e8e4dc;
    padding-top: 1.2rem;
    padding-bottom: 1.2rem;
    margin-bottom: 3.5rem;
    background: transparent;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  .atelier-view-switchers {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .atelier-view-btn {
    background: none;
    border: none;
    padding: 5px;
    cursor: pointer;
    color: #a49f96;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease, transform 0.15s ease;
    line-height: 1;
    border-radius: 2px;
  }

  .atelier-view-btn:hover {
    color: #1a1a1a;
  }

  .atelier-view-btn.is-active {
    color: #1a1a1a;
  }

  .atelier-toolbar-center {
    flex: 1;
    text-align: center;
  }

  .atelier-toolbar-count {
    font-family: var(--font-heading-family, 'Playfair Display', Georgia, serif);
    font-size: 1.4rem;
    letter-spacing: 0.08em;
    color: #555555;
    font-weight: 400;
  }

  .atelier-toolbar-sort {
    display: flex;
    align-items: center;
  }

  .atelier-sort-form {
    display: flex;
    align-items: center;
    position: relative;
    margin: 0;
  }

  .atelier-sort-select {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: none;
    padding: 4px 22px 4px 6px;
    font-family: inherit;
    font-size: 1.35rem;
    letter-spacing: 0.04em;
    color: #4a4a4a;
    cursor: pointer;
    outline: none;
  }

  .atelier-sort-caret {
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: #555;
  }

  /* Left Sidebar Filters & Vertical Layout (Desktop 280px left column + Product Grid right) */
  .facets-vertical {
    display: flex !important;
    align-items: flex-start !important;
    gap: 3.5rem !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  .facets-vertical .facets-wrapper {
    width: 270px !important;
    max-width: 270px !important;
    padding-right: 0 !important;
    flex-shrink: 0 !important;
  }

  .facets-vertical .product-grid-container {
    flex: 1 1 auto !important;
    width: calc(100% - 270px - 3.5rem) !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
  }

  .atelier-sidebar-filters {
    font-family: inherit;
    color: #2b2b2b;
  }

  .atelier-active-filters-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: #f7f5f0;
    border-radius: 2px;
    margin-bottom: 2rem;
    font-size: 1.25rem;
  }

  .atelier-active-filters-label {
    font-weight: 500;
    color: #666;
  }

  .atelier-clear-all-link {
    background: none;
    border: none;
    padding: 0;
    font-size: 1.25rem;
    text-decoration: underline;
    cursor: pointer;
    color: #1a1a1a;
    font-weight: 600;
  }

  .atelier-clear-all-link:hover {
    color: #8b7355;
  }

  .atelier-filter-group {
    border-bottom: 1px solid #ebe7df;
    padding: 1.8rem 0;
  }

  .atelier-filter-group:first-of-type {
    padding-top: 0;
  }

  .atelier-filter-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
    user-select: none;
    font-size: 1.45rem;
    font-weight: 500;
    color: #1f1f1f;
    letter-spacing: 0.02em;
  }

  .atelier-filter-summary::-webkit-details-marker {
    display: none;
  }

  .atelier-caret-icon {
    transition: transform 0.25s ease;
    color: #444;
  }

  details[open] > .atelier-filter-summary .atelier-caret-icon {
    transform: rotate(180deg);
  }

  .atelier-filter-list {
    list-style: none;
    margin: 1.2rem 0 0 0;
    padding: 0;
  }

  .atelier-filter-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 0;
    font-size: 1.35rem;
    color: #4a4a4a;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .atelier-filter-link {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    color: inherit;
    text-decoration: none;
    font-family: inherit;
    font-size: inherit;
  }

  .atelier-filter-item:hover,
  .atelier-filter-link:hover {
    color: #1a1a1a;
  }

  .atelier-filter-count {
    color: #8c8c8c;
    font-size: 1.25rem;
  }

  .atelier-filter-item.is-active {
    color: #1a1a1a;
    font-weight: 600;
  }

  .atelier-filter-item.is-active .atelier-filter-name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .atelier-color-filter-wrapper {
    margin: 1.8rem 0;
  }

  .atelier-color-custom-select {
    position: relative;
    width: 100%;
    border: 1px solid #1a1a1a;
    border-radius: 1px;
    background: #ffffff;
  }

  .atelier-color-select {
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
    padding: 10px 32px 10px 14px;
    font-size: 1.35rem;
    font-family: inherit;
    color: #1a1a1a;
    background: transparent;
    border: none;
    outline: none;
    cursor: pointer;
  }

  .atelier-color-caret {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: #222;
  }

  .atelier-price-box {
    margin-top: 1.4rem;
  }

  .atelier-price-inputs {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 1rem;
  }

  .atelier-price-currency {
    font-size: 1.3rem;
    color: #666;
  }

  .atelier-price-input {
    width: 70px;
    padding: 6px 8px;
    border: 1px solid #dcd7ce;
    border-radius: 1px;
    font-size: 1.3rem;
    font-family: inherit;
  }

  .atelier-price-separator {
    color: #999;
  }

  .atelier-price-btn {
    width: 100%;
    padding: 9px 12px;
    background: #ffffff !important;
    color: #7a5168 !important;
    border: 1.5px solid #7a5168 !important;
    border-radius: 4px;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(122, 81, 104, 0.12);
    transition: all 0.2s ease;
  }

  .atelier-price-btn:hover {
    background: #7a5168 !important;
    border-color: #7a5168 !important;
    color: #FFFFFF !important;
    box-shadow: 0 4px 12px rgba(122, 81, 104, 0.25);
  }

  /* Fix product cards sizing: ensure grid items fill their grid column */
  #product-grid .grid__item,
  .product-grid-item-filterable {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
  }

  #product-grid .card-wrapper {
    width: 100% !important;
    height: 100% !important;
  }

  #product-grid .card {
    width: 100% !important;
  }

  /* Grid Layout Views: Compact, elegant cards */
  #product-grid.view-mode-3 {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 1.6rem 1.2rem !important;
    width: 100% !important;
  }

  #product-grid.view-mode-4 {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 1.4rem 1rem !important;
    width: 100% !important;
  }

  #product-grid.view-mode-2 {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 1.8rem 1.4rem !important;
    width: 100% !important;
  }

  #product-grid:not(.view-mode-1) .grid__item {
    width: 100% !important;
    max-width: 100% !important;
  }

  /* =========================================================================
     LIST VIEW MODE (Xếp ngang / 1-Column Horizontal Row Layout)
     ========================================================================= */
  #product-grid.view-mode-1 {
    display: flex !important;
    flex-direction: column !important;
    gap: 1.4rem !important;
    width: 100% !important;
  }

  #product-grid.view-mode-1 .grid__item {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
  }

  #product-grid.view-mode-1 .card-wrapper {
    width: 100% !important;
    height: auto !important;
  }

  #product-grid.view-mode-1 .card {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    width: 100% !important;
    background: #ffffff !important;
    border: 1px solid #EAE5DC !important;
    border-radius: 16px !important;
    overflow: hidden !important;
    padding: 12px 24px 12px 14px !important;
    gap: 20px !important;
    box-shadow: 0 4px 14px rgba(22, 51, 39, 0.05) !important;
    transition: transform 0.25s ease, box-shadow 0.25s ease !important;
    box-sizing: border-box !important;
    min-height: 120px !important;
  }

  #product-grid.view-mode-1 .card:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 24px rgba(22, 51, 39, 0.1) !important;
  }

  /* Left media thumbnail - generous 130px on desktop */
  #product-grid.view-mode-1 .card__inner {
    width: 130px !important;
    min-width: 130px !important;
    max-width: 130px !important;
    height: 130px !important;
    min-height: 130px !important;
    position: relative !important;
    padding-bottom: 0 !important;
    border-radius: 12px !important;
    overflow: hidden !important;
    background: #f8f6f3 !important;
    flex-shrink: 0 !important;
  }

  #product-grid.view-mode-1 .card__inner.ratio:before {
    display: none !important;
    padding-bottom: 0 !important;
  }

  #product-grid.view-mode-1 .card__inner .card__media {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    border-radius: 12px !important;
    overflow: hidden !important;
  }

  #product-grid.view-mode-1 .card__inner .card__media .media {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
  }

  #product-grid.view-mode-1 .card__inner .card__media img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    transition: transform 0.35s ease !important;
  }

  #product-grid.view-mode-1 .card:hover .card__inner .card__media img {
    transform: scale(1.05) !important;
  }

  /* HIDE redundant photo-blocking badge and hover actions in List View mode so the image is never blocked */
  #product-grid.view-mode-1 .card__inner .card__badge,
  #product-grid.view-mode-1 .card__hover-actions {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* Right content box */
  #product-grid.view-mode-1 .card > .card__content {
    flex: 1 1 auto !important;
    display: flex !important;
    flex-direction: row !important;
    justify-content: space-between !important;
    align-items: center !important;
    padding: 0 !important;
    gap: 20px !important;
    width: calc(100% - 150px) !important;
    box-sizing: border-box !important;
  }

  #product-grid.view-mode-1 .card > .card__content .card__information {
    flex: 1 1 auto !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: flex-start !important;
    text-align: left !important;
    padding: 0 !important;
  }

  #product-grid.view-mode-1 .card__eyebrow {
    font-size: 11px !important;
    font-weight: 800 !important;
    letter-spacing: 0.08em !important;
    color: #7a5168 !important;
    text-transform: uppercase !important;
    margin: 0 0 3px 0 !important;
    display: block !important;
    line-height: 1.1 !important;
  }

  #product-grid.view-mode-1 .card__heading {
    text-align: left !important;
    font-size: 1.55rem !important;
    font-weight: 700 !important;
    line-height: 1.3 !important;
    margin: 0 0 4px 0 !important;
    letter-spacing: -0.01em !important;
  }

  #product-grid.view-mode-1 .card__heading a {
    color: #0f172a !important;
    font-weight: 700 !important;
    text-decoration: none !important;
    transition: color 0.2s ease !important;
  }

  #product-grid.view-mode-1 .card__heading a:hover {
    color: #7a5168 !important;
    text-decoration: none !important;
  }

  #product-grid.view-mode-1 .card-information {
    display: flex !important;
    align-items: baseline !important;
    gap: 12px !important;
    margin: 0 !important;
  }

  #product-grid.view-mode-1 .card-information .price {
    text-align: left !important;
    justify-content: flex-start !important;
    font-size: 1.45rem !important;
    font-weight: 700 !important;
    color: #0f172a !important;
    margin: 0 !important;
  }

  /* FIX: Ensure only ONE price is displayed. Hide price__sale if not on sale; hide price__regular if on sale */
  #product-grid.view-mode-1 .card-information .price:not(.price--on-sale) .price__sale {
    display: none !important;
  }

  #product-grid.view-mode-1 .card-information .price.price--on-sale .price__regular {
    display: none !important;
  }

  #product-grid.view-mode-1 .card-information .price.price--on-sale .price__sale {
    display: flex !important;
    align-items: baseline !important;
    gap: 8px !important;
  }

  #product-grid.view-mode-1 .quick-add {
    flex-shrink: 0 !important;
    margin: 0 !important;
    min-width: 130px !important;
  }

  #product-grid.view-mode-1 .quick-add modal-opener {
    display: block !important;
    width: 100% !important;
  }

  #product-grid.view-mode-1 .quick-add form {
    width: 100% !important;
  }

  #product-grid.view-mode-1 .quick-add__submit {
    min-width: 140px !important;
    padding: 10px 20px !important;
    border-radius: 9999px !important;
    font-size: 1.25rem !important;
    letter-spacing: 0.04em !important;
    font-weight: 700 !important;
    background: #ffffff !important;
    border: 1.5px solid #7a5168 !important;
    color: #7a5168 !important;
    box-shadow: 0 2px 8px rgba(122, 81, 104, 0.12) !important;
    transition: all 0.25s ease !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    cursor: pointer !important;
  }

  #product-grid.view-mode-1 .quick-add__submit svg.card-atc-icon {
    stroke: currentColor !important;
    color: inherit !important;
  }

  #product-grid.view-mode-1 .quick-add__submit:hover {
    background: #7a5168 !important;
    border-color: #7a5168 !important;
    color: #ffffff !important;
    box-shadow: 0 6px 18px rgba(122, 81, 104, 0.35) !important;
    transform: translateY(-2px) !important;
  }

  #product-grid.view-mode-1 .quick-add__submit:active {
    background: #623e52 !important;
    border-color: #623e52 !important;
    color: #ffffff !important;
    transform: scale(0.98) !important;
  }

  /* =========================================================================
     GEAR UP MY CAR: LUXURY RED-BLACK PRODUCT CARD
     ========================================================================= */
  #product-grid:not(.view-mode-1) .card-wrapper {
    width: 100% !important;
    height: 100% !important;
    display: flex !important;
    flex-direction: column !important;
  }

  #product-grid:not(.view-mode-1) .card {
    position: relative !important;
    background: #ffffff !important;
    border: 1px solid #e5e7eb !important;
    border-radius: 12px !important;
    padding: 10px 10px 12px !important;
    overflow: hidden !important;
    display: flex !important;
    flex-direction: column !important;
    height: 100% !important;
    box-sizing: border-box !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03) !important;
    transition: transform 0.25s ease,
                box-shadow 0.25s ease,
                border-color 0.2s ease !important;
  }

  #product-grid:not(.view-mode-1) .card:before,
  #product-grid:not(.view-mode-1) .card:after {
    display: none !important;
    content: none !important;
  }

  #product-grid:not(.view-mode-1) .card:hover {
    transform: translateY(-3px) !important;
    border-color: rgba(122, 81, 104, 0.3) !important;
    box-shadow: 0 8px 20px rgba(122, 81, 104, 0.1) !important;
  }

  /* Inner Image Box (1:1 Square Frame) - Clean, Studio Backdrop */
  #product-grid:not(.view-mode-1) .card__inner {
    position: relative !important;
    width: 100% !important;
    aspect-ratio: 1 / 1 !important;
    height: auto !important;
    border-radius: 8px !important;
    overflow: hidden !important;
    background: #f8fafc !important;
    border: 1px solid rgba(0, 0, 0, 0.04) !important;
    display: block !important;
    box-sizing: border-box !important;
  }

  #product-grid:not(.view-mode-1) .card__inner.ratio:before {
    display: none !important;
    padding-bottom: 0 !important;
  }

  #product-grid:not(.view-mode-1) .card__inner:after {
    display: none !important;
    content: none !important;
  }

  #product-grid:not(.view-mode-1) .card__media {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    border-radius: 8px !important;
    overflow: hidden !important;
  }

  #product-grid:not(.view-mode-1) .card__media .media {
    width: 100% !important;
    height: 100% !important;
    position: relative !important;
    background: transparent !important;
  }

  #product-grid:not(.view-mode-1) .card__media .media img {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
    padding: 8px !important;
    box-sizing: border-box !important;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease !important;
  }

  #product-grid:not(.view-mode-1) .card:hover .card__media .media img {
    transform: scale(1.07) !important;
  }

  /* Inner Content & Badges Container */
  #product-grid .card__inner .card__content {
    position: static !important;
    display: block !important;
    padding: 0 !important;
  }

  /* Racing Red & Dark Badges */
  #product-grid .card__inner .card__badge {
    position: absolute !important;
    top: 10px !important;
    left: 10px !important;
    right: auto !important;
    bottom: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    z-index: 4 !important;
    display: flex !important;
    pointer-events: none !important;
  }

  #product-grid .card__inner .card__badge .badge,
  #product-grid .card__inner .card__badge .badge--sale {
    display: inline-flex !important;
    align-items: center !important;
    gap: 4px !important;
    background: linear-gradient(135deg, #e50914 0%, #b3070f 100%) !important;
    color: #FFFFFF !important;
    border: 1px solid rgba(255, 255, 255, 0.35) !important;
    font-size: 11px !important;
    font-weight: 800 !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
    padding: 4px 10px !important;
    border-radius: 999px !important;
    line-height: 1.15 !important;
    box-shadow: 0 3px 10px rgba(229, 9, 20, 0.4) !important;
  }

  #product-grid .card__inner .card__badge .badge--soldout {
    display: inline-flex !important;
    align-items: center !important;
    background: rgba(15, 23, 42, 0.88) !important;

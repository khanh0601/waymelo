    #product-grid.view-mode-2 {
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 1.4rem 0.9rem !important;
      width: 100% !important;
    }

    /* Product Cards Mobile Proportions */
    #product-grid:not(.view-mode-1) .card {
      padding: 10px 10px 13px !important;
      border-radius: 18px !important;
      border: 1px solid #EAE5DC !important;
      background: #FFFFFF !important;
      box-shadow: 0 4px 14px rgba(22, 51, 39, 0.05) !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: space-between !important;
      transition: transform 0.2s ease, box-shadow 0.2s ease !important;
    }

    #product-grid:not(.view-mode-1) .card {
      border-radius: 10px !important;
      padding: 8px 8px 10px !important;
    }

    #product-grid:not(.view-mode-1) .card__inner,
    #product-grid:not(.view-mode-1) .card__media {
      border-radius: 8px !important;
      overflow: hidden !important;
    }

    #product-grid .card__inner .card__badge {
      top: 6px !important;
      left: 6px !important;
    }
    #product-grid .card__inner .card__badge .badge {
      font-size: 9px !important;
      font-weight: 700 !important;
      padding: 3px 7px !important;
      letter-spacing: 0.05em !important;

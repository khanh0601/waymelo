    #product-grid:not(.view-mode-1) .card > .card__content {
      margin-top: 0 !important;
      padding: 8px 0 0 0 !important;
      width: 100% !important;
      display: flex !important;
      flex-direction: column !important;
      flex: 1 1 auto !important;
    }

    /* Card Text & Alignment */
    #product-grid:not(.view-mode-1) .card__eyebrow {
      font-size: 9.5px !important;
      font-weight: 700 !important;
      letter-spacing: 0.06em !important;
      color: #7a5168 !important;
      margin-bottom: 4px !important;
      text-align: left !important;
      display: block !important;
      text-transform: uppercase !important;
    }

    #product-grid:not(.view-mode-1) .card__heading {
      font-size: 13px !important;
      font-weight: 600 !important;
      line-height: 1.3 !important;
      min-height: 0 !important;
      height: auto !important;
      margin-bottom: 6px !important;
      text-align: left !important;
    }
    #product-grid:not(.view-mode-1) .card__heading a {
      font-size: 13px !important;
      font-weight: 600 !important;
      color: #1f2937 !important;
      line-height: 1.3 !important;
      text-decoration: none !important;
    }

    /* Reviews on Mobile */
    #product-grid .jdgm-prev-badge__text,
    #product-grid .rating-text {
      font-size: 11px !important;
      font-weight: 600 !important;
      color: #6b7280 !important;
    }
    #product-grid .jdgm-prev-badge {
      text-align: left !important;
      margin-bottom: 6px !important;
      display: block !important;
    }

    /* Price on Mobile: Elegant 2-line layout */
    #product-grid:not(.view-mode-1) .card-information {
      justify-content: flex-start !important;
      text-align: left !important;
      width: 100% !important;
      margin: 0 0 8px 0 !important;
    }
    #product-grid:not(.view-mode-1) .price {
      margin: 0 !important;
      min-height: auto !important;
      text-align: left !important;
      justify-content: flex-start !important;
      width: 100% !important;
    }
    #product-grid:not(.view-mode-1) .price__container {
      text-align: left !important;
      justify-content: flex-start !important;
      width: 100% !important;
    }
    #product-grid:not(.view-mode-1) .price.price--on-sale .price__sale,
    #product-grid:not(.view-mode-1) .price.price--on-sale .price__sale.price__price-first {
      display: flex !important;
      flex-flow: row wrap !important;
      align-items: baseline !important;
      justify-content: flex-start !important;
      gap: 3px 6px !important;
      width: 100% !important;
      text-align: left !important;
    }
    #product-grid:not(.view-mode-1) .price-item--sale {
      width: 100% !important;
      text-align: left !important;
      font-size: 13.5px !important;
      font-weight: 700 !important;
      color: #111827 !important;
      margin: 0 !important;
      order: 1 !important;
      display: block !important;
    }
    #product-grid:not(.view-mode-1) .price__regular .price-item--regular {
      width: 100% !important;
      text-align: left !important;
      font-size: 13.5px !important;
      font-weight: 700 !important;
      color: #111827 !important;
      margin: 0 !important;
      display: block !important;
    }
    #product-grid:not(.view-mode-1) .price-item--compare-wrap {
      width: auto !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: flex-start !important;
      margin: 0 !important;
      order: 2 !important;
    }
    #product-grid:not(.view-mode-1) .price-item--compare-wrap s,
    #product-grid:not(.view-mode-1) .price__sale s {
      font-size: 11.5px !important;
      font-weight: 400 !important;
      color: #9ca3af !important;
      text-decoration: line-through !important;
      line-height: 1 !important;
      margin: 0 !important;
    }
    #product-grid:not(.view-mode-1) .lbs-discount-pill {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: auto !important;
      max-width: fit-content !important;
      font-size: 9.5px !important;
      font-weight: 700 !important;
      padding: 1px 5px !important;
      border-radius: 999px !important;
      margin: 0 !important;
      order: 3 !important;
      align-self: center !important;
      background: rgba(229, 9, 20, 0.08) !important;
      color: #e50914 !important;
      border: 1px solid rgba(229, 9, 20, 0.22) !important;
      line-height: 1 !important;
    }

    /* Add to Cart Button & Quantity Stepper on Mobile */
    #product-grid:not(.view-mode-1) .quick-add,
    #product-grid .quick-add {
      margin: auto 0 0 0 !important;
      margin-top: auto !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }
    #product-grid .card__atc-row {
      gap: 5px !important;
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }
    #product-grid .card-atc-stepper,
    #product-grid .card-atc-stepper.quantity {
      width: 68px !important;
      min-width: 68px !important;
      max-width: 68px !important;
      height: 34px !important;
      min-height: 34px !important;
      padding: 0 2px !important;
    }
    #product-grid .card-atc-stepper .quantity__button {
      width: 20px !important;
      min-width: 20px !important;
      height: 30px !important;
    }
    #product-grid .card-atc-stepper .quantity__input {
      width: 22px !important;
      font-size: 12px !important;
    }
    #product-grid:not(.view-mode-1) .quick-add__submit {
      width: 100% !important;
      padding: 6px 6px !important;
      min-height: 34px !important;
      height: 34px !important;
      font-size: 11px !important;
      letter-spacing: 0 !important;
      border-radius: 999px !important;
      border: 1.5px solid #7a5168 !important;
      background: #ffffff !important;
      color: #7a5168 !important;
      gap: 4px !important;
      box-shadow: 0 2px 6px rgba(122, 81, 104, 0.08) !important;
      line-height: 1 !important;
      transition: all 0.2s ease !important;
      box-sizing: border-box !important;
    }
    #product-grid:not(.view-mode-1) .quick-add__submit:active {
      transform: scale(0.97) !important;
      background: #7a5168 !important;
      border-color: #7a5168 !important;
      color: #ffffff !important;
    }
    #product-grid:not(.view-mode-1) .quick-add__submit svg.card-atc-icon {
      width: 12px !important;
      height: 12px !important;
      stroke-width: 2 !important;
      stroke: currentColor !important;
      color: inherit !important;
      flex-shrink: 0 !important;
    }

    /* =========================================================
       LIST VIEW MODE ON MOBILE (< 750px)
       Compact, balanced, prominent image, zero photo obstruction
       ========================================================= */
    #product-grid.view-mode-1 {
      gap: 12px !important;
      display: flex !important;
      flex-direction: column !important;
      width: 100% !important;
    }
    #product-grid.view-mode-1 .grid__item {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
    }
    #product-grid.view-mode-1 .card {
      display: flex !important;
      flex-direction: row !important;
      align-items: stretch !important;
      padding: 10px !important;
      border-radius: 16px !important;
      border: 1px solid #EAE5DC !important;
      background: #FFFFFF !important;
      box-shadow: 0 4px 14px rgba(22, 51, 39, 0.05) !important;
      gap: 12px !important;
      min-height: 124px !important;
      box-sizing: border-box !important;
    }

    /* 1. Large, prominent media on the left - 120px */
    #product-grid.view-mode-1 .card__inner {
      width: 120px !important;
      min-width: 120px !important;
      max-width: 120px !important;
      height: 120px !important;
      min-height: 120px !important;
      border-radius: 12px !important;
      overflow: hidden !important;
      background: #F8F6F3 !important;
      flex-shrink: 0 !important;
      position: relative !important;
    }
    #product-grid.view-mode-1 .card__inner .card__media {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100% !important;
    }
    #product-grid.view-mode-1 .card__inner .card__media img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
    }

    /* 2. Hide badge over photo in List View so artwork is 100% visible */
    #product-grid.view-mode-1 .card__inner .card__badge {
      display: none !important;
    }

    /* 3. Right content area: balanced & snug */
    #product-grid.view-mode-1 .card > .card__content {
      flex: 1 1 auto !important;
      min-width: 0 !important;
      width: calc(100% - 132px) !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: space-between !important;
      align-items: flex-start !important;
      padding: 2px 0 !important;
      gap: 0 !important;
    }
    #product-grid.view-mode-1 .card__information {
      width: 100% !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    #product-grid.view-mode-1 .card__eyebrow {
      font-size: 9.5px !important;
      font-weight: 800 !important;
      letter-spacing: 0.1em !important;
      color: #7a5168 !important;
      text-transform: uppercase !important;
      margin: 0 0 2px 0 !important;
      line-height: 1.1 !important;
      display: block !important;
    }
    #product-grid.view-mode-1 .card__heading {
      font-size: 14.5px !important;
      font-weight: 800 !important;
      line-height: 1.25 !important;
      margin: 0 0 4px 0 !important;
      text-align: left !important;
      display: -webkit-box !important;
      -webkit-line-clamp: 2 !important;
      -webkit-box-orient: vertical !important;
      overflow: hidden !important;
      min-height: auto !important;
    }
    #product-grid.view-mode-1 .card__heading a {
      font-size: 14.5px !important;
      font-weight: 800 !important;
      color: #050807 !important;
      line-height: 1.25 !important;
    }

    /* 4. Reviews line */
    #product-grid.view-mode-1 .jdgm-prev-badge {
      margin-bottom: 4px !important;
      line-height: 1 !important;
      display: block !important;
    }
    #product-grid.view-mode-1 .jdgm-prev-badge__text,
    #product-grid.view-mode-1 .rating-text {
      font-size: 11px !important;
      font-weight: 700 !important;
    }

    /* 5. Clean Single-Row Price in List View */
    #product-grid.view-mode-1 .card-information {
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: flex-start !important;
      width: 100% !important;
      margin: 0 0 6px 0 !important;
    }
    #product-grid.view-mode-1 .price {
      margin: 0 !important;
      min-height: auto !important;
      width: auto !important;
      text-align: left !important;
    }
    #product-grid.view-mode-1 .price__container {
      text-align: left !important;
      justify-content: flex-start !important;
      width: auto !important;
    }
    #product-grid.view-mode-1 .price.price--on-sale .price__sale,
    #product-grid.view-mode-1 .price.price--on-sale .price__sale.price__price-first {
      display: inline-flex !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: flex-start !important;
      flex-wrap: wrap !important;
      gap: 5px !important;
      width: auto !important;
    }
    #product-grid.view-mode-1 .price-item--sale {
      width: auto !important;
      display: inline !important;
      font-size: 15px !important;
      font-weight: 800 !important;
      color: #7a5168 !important;
      order: 1 !important;
    }
    #product-grid.view-mode-1 .price-item--compare-wrap {
      width: auto !important;
      display: inline-flex !important;
      order: 2 !important;
      margin: 0 !important;
    }
    #product-grid.view-mode-1 .price-item--compare-wrap s,
    #product-grid.view-mode-1 .price__sale s {
      font-size: 12px !important;
      color: #8C827A !important;
    }
    #product-grid.view-mode-1 .lbs-discount-pill {
      order: 3 !important;
      margin: 0 !important;
      font-size: 9.5px !important;
      padding: 1px 5px !important;
    }

    /* 6. Compact Luxury ADD TO CART Button */
    #product-grid.view-mode-1 .quick-add {
      margin-top: auto !important;
      width: 100% !important;
    }
    #product-grid.view-mode-1 .quick-add__submit {
      width: 100% !important;
      padding: 6px 12px !important;
      min-height: 32px !important;
      height: 32px !important;
      font-size: 11px !important;
      font-weight: 800 !important;
      letter-spacing: 0.07em !important;
      border-radius: 999px !important;
      border: 1.5px solid #7a5168 !important;
      background: #ffffff !important;
      color: #7a5168 !important;
      gap: 5px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }
    #product-grid.view-mode-1 .quick-add__submit svg.card-atc-icon {
      width: 12px !important;
      height: 12px !important;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  {%- paginate collection.products by section.settings.products_per_page -%}
    {% comment %} Atelier Luxury Top Toolbar {% endcomment %}
    <div class="atelier-collection-toolbar page-width">
      <div class="atelier-view-switchers" aria-label="View mode">
        <!-- 2 Column View Button -->
        <button type="button" class="atelier-view-btn" data-view="2" aria-label="2 columns view" title="2 columns">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor">
            <rect x="1" y="1" width="6.5" height="6.5" rx="1"/>
            <rect x="10.5" y="1" width="6.5" height="6.5" rx="1"/>
            <rect x="1" y="10.5" width="6.5" height="6.5" rx="1"/>
            <rect x="10.5" y="10.5" width="6.5" height="6.5" rx="1"/>
          </svg>
        </button>

        <!-- 3 Column View Button (Default Active) -->
        <button type="button" class="atelier-view-btn is-active" data-view="3" aria-label="3 columns view" title="3 columns">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor">
            <rect x="1" y="1" width="4" height="4" rx="0.5"/>
            <rect x="7" y="1" width="4" height="4" rx="0.5"/>
            <rect x="13" y="1" width="4" height="4" rx="0.5"/>
            <rect x="1" y="7" width="4" height="4" rx="0.5"/>
            <rect x="7" y="7" width="4" height="4" rx="0.5"/>
            <rect x="13" y="7" width="4" height="4" rx="0.5"/>
            <rect x="1" y="13" width="4" height="4" rx="0.5"/>
            <rect x="7" y="13" width="4" height="4" rx="0.5"/>
            <rect x="13" y="13" width="4" height="4" rx="0.5"/>
          </svg>
        </button>

        <!-- 1 Column / List View Button -->
        <button type="button" class="atelier-view-btn" data-view="1" aria-label="List view" title="List view">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor">
            <rect x="1" y="2.5" width="16" height="2.5" rx="0.5"/>
            <rect x="1" y="7.5" width="16" height="2.5" rx="0.5"/>
            <rect x="1" y="12.5" width="16" height="2.5" rx="0.5"/>
          </svg>
        </button>
      </div>

      <div class="atelier-toolbar-center">
        <span class="atelier-toolbar-count" id="AtelierProductCount">
          {{ collection.products_count }} products
        </span>
      </div>

      <div class="atelier-toolbar-sort">
        {%- if section.settings.enable_sorting -%}
          <form class="atelier-sort-form" id="AtelierSortForm">
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- if collection.handle == 'new-array' and collection.sort_by == blank -%}
              {%- assign sort_by = 'created-descending' -%}
            {%- endif -%}
            <select name="sort_by" class="atelier-sort-select" id="AtelierSortBy" aria-label="Sort products">
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected="selected"{% endif %}>
                  {{ option.name | escape }}
                </option>
              {%- endfor -%}
            </select>
            <svg class="atelier-sort-caret" width="10" height="6" viewBox="0 0 10 6" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z"/>
            </svg>
          </form>
        {%- endif -%}
      </div>
    </div>

    <div class="{% if section.settings.enable_filtering %}facets-vertical {% endif %}page-width">
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {%- if section.settings.enable_filtering -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          <!-- Mobile Collapsible Filter Toggle Bar -->
          <div class="atelier-mobile-filter-bar">
            <button type="button" class="atelier-mobile-filter-btn" id="AtelierMobileFilterBtn" aria-expanded="false" aria-controls="AtelierMobileFilterContent">
              <span class="atelier-mobile-filter-btn-left">
                <svg class="atelier-filter-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="4" y1="6" x2="20" y2="6"></line>
                  <line x1="8" y1="12" x2="16" y2="12"></line>
                  <line x1="10" y1="18" x2="14" y2="18"></line>
                </svg>
                <span class="atelier-mobile-filter-btn-title">Filters & Categories</span>
              </span>
              <span class="atelier-mobile-filter-btn-right">
                <span class="atelier-mobile-filter-status" id="AtelierFilterCountBadge" style="display: none;">0 active</span>
                <svg class="atelier-mobile-filter-chevron" width="10" height="6" viewBox="0 0 10 6" fill="currentColor">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z"/>
                </svg>
              </span>
            </button>
          </div>
          <div class="atelier-mobile-filter-collapsible" id="AtelierMobileFilterContent">
            {% render 'atelier-sidebar-filters', results: collection, collection: collection %}
          </div>
        </aside>
      {%- endif -%}

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        id="ProductGridContainer"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div
            class="collection"
          >
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="grid product-grid view-mode-3"
            >
              {% assign skip_card_product_styles = false %}
              {%- for product in collection.products -%}
                {% assign lazy_load = false %}
                {%- if forloop.index > 2 -%}
                  {%- assign lazy_load = true -%}
                {%- endif -%}

                {%- liquid
                  assign p_type_raw = product.type | downcase
                  assign p_title_raw = product.title | downcase
                  assign p_tags_raw = product.tags | join: ' ' | downcase
                  
                  assign p_type_key = 'mahjong-set'
                  if p_type_raw contains 'mat' or p_title_raw contains 'mat'
                    assign p_type_key = 'mats'
                  elsif p_type_raw contains 'rack' or p_title_raw contains 'rack' or p_type_raw contains 'pusher' or p_title_raw contains 'pusher'
                    assign p_type_key = 'racks'
                  elsif p_type_raw contains 'dice' or p_type_raw contains 'xúc' or p_title_raw contains 'dice'
                    assign p_type_key = 'dices'
                  elsif p_type_raw contains 'bag' or p_title_raw contains 'bag'
                    assign p_type_key = 'tile-bag'
                  else
                    assign p_type_key = 'mahjong-set'
                  endif

                  assign p_col_handles = ''
                  for c in product.collections
                    assign p_col_handles = p_col_handles | append: ' ' | append: c.handle
                  endfor

                  assign colors_detected = ''
                  for opt in product.options_with_values
                    assign opt_name = opt.name | downcase
                    if opt_name contains 'color' or opt_name contains 'màu'
                      for val in opt.values
                        assign v_down = val | downcase
                        assign colors_detected = colors_detected | append: ' ' | append: v_down
                      endfor
                    endif
                  endfor

                  assign p_desc_raw = product.description | strip_html | downcase
                  assign full_search_text = p_title_raw | append: ' ' | append: p_tags_raw | append: ' ' | append: colors_detected | append: ' ' | append: p_desc_raw

                  assign final_colors = ''
                  if full_search_text contains 'white' or full_search_text contains 'ivory' or full_search_text contains 'pearl' or full_search_text contains 'resin'
                    assign final_colors = final_colors | append: ' white'
                  endif
                  if full_search_text contains 'pink' or full_search_text contains 'blush' or full_search_text contains 'rose' or full_search_text contains 'bloom' or full_search_text contains 'blossom' or full_search_text contains 'lotus' or full_search_text contains 'flora'
                    assign final_colors = final_colors | append: ' pink'
                  endif
                  if full_search_text contains 'green' or full_search_text contains 'jade' or full_search_text contains 'aventurine' or full_search_text contains 'moss' or full_search_text contains 'palm' or full_search_text contains 'garden' or full_search_text contains 'woodland'
                    assign final_colors = final_colors | append: ' green'
                  endif
                  if full_search_text contains 'gold' or full_search_text contains 'yellow' or full_search_text contains 'tiger eye' or full_search_text contains 'leopard' or full_search_text contains 'dynasty' or full_search_text contains 'lantern' or full_search_text contains 'cocktail'
                    assign final_colors = final_colors | append: ' gold'
                  endif
                  if full_search_text contains 'black' or full_search_text contains 'obsidian' or full_search_text contains 'leopard'
                    assign final_colors = final_colors | append: ' black'
                  endif
                  if full_search_text contains 'cream' or full_search_text contains 'beige' or full_search_text contains 'tan' or full_search_text contains 'leopard' or full_search_text contains 'swirl' or full_search_text contains 'woodland'
                    assign final_colors = final_colors | append: ' cream'
                  endif
                  if full_search_text contains 'lavender' or full_search_text contains 'amethyst' or full_search_text contains 'purple'
                    assign final_colors = final_colors | append: ' lavender'
                  endif
                  if full_search_text contains 'quartz' or full_search_text contains 'clear' or full_search_text contains 'crystal' or full_search_text contains 'pearl' or full_search_text contains 'acrylic' or full_search_text contains 'swirl'
                    assign final_colors = final_colors | append: ' quartz'
                  endif
                  if full_search_text contains 'crimson' or full_search_text contains 'red' or full_search_text contains 'lantern'
                    assign final_colors = final_colors | append: ' crimson'
                  endif

                  assign prod_price_num = product.price | divided_by: 100.0
                -%}

                <li
                  class="grid__item product-grid-item-filterable{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  data-product-type="{{ p_type_key }}"
                  data-product-collections="{{ p_col_handles | strip }} {{ p_type_key }} {% if p_type_key == 'mahjong-set' %}tiles{% elsif p_type_key == 'tile-bag' %}bag{% endif %}"
                  data-product-colors="{{ final_colors | strip }}"
                  data-product-price="{{ prod_price_num }}"
                  data-product-available="{{ product.available }}"
                  data-product-created="{{ product.created_at | date: '%s' }}"
                  data-product-id="{{ product.id }}"
                  data-product-title="{{ product.title | escape }}"
                  data-original-index="{{ forloop.index0 }}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    lazy_load: lazy_load,
                    skip_styles: skip_card_product_styles,
                    quick_add: section.settings.quick_add,
                    section_id: section.id
                  %}
                </li>
                {%- assign skip_card_product_styles = true -%}
              {%- endfor -%}
            </ul>

            <!-- Empty Filter Message -->
            <div id="AtelierEmptyFilterMessage" class="atelier-empty-filter-message" style="display: none; text-align: center; padding: 6rem 2rem;">
              <p style="font-size: 1.8rem; font-family: var(--font-heading-family); color: #222; margin-bottom: 1.5rem;">No products match your selected filters</p>
              <button type="button" class="button" id="AtelierResetFiltersBtn" style="min-width: 160px;">Clear all filters</button>
            </div>

            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate, anchor: '' %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}

  {% comment %} Interactive Filter & View Engine {% endcomment %}
  <script>
    (function() {
      function initAtelierFilters() {
        const grid = document.getElementById('product-grid');
        const items = document.querySelectorAll('.product-grid-item-filterable');
        const countEl = document.getElementById('AtelierProductCount');
        const emptyMsg = document.getElementById('AtelierEmptyFilterMessage');
        const activeBar = document.getElementById('AtelierActiveFiltersBar');
        const clearAllBtn = document.getElementById('AtelierClearAllFilters');
        const resetBtn = document.getElementById('AtelierResetFiltersBtn');
        const colorSelect = document.getElementById('AtelierColorFilter');
        const minPriceInput = document.getElementById('AtelierPriceMin');
        const maxPriceInput = document.getElementById('AtelierPriceMax');
        const priceApplyBtn = document.getElementById('AtelierPriceFilterBtn');
        const typeItems = document.querySelectorAll('.atelier-filter-type-item');
        const availItems = document.querySelectorAll('.atelier-filter-avail-item');
        const viewBtns = document.querySelectorAll('.atelier-view-btn');
        const sortSelect = document.getElementById('AtelierSortBy');

        if (!grid || !items.length) return;

        let activeColor = '';
        let activeMinPrice = null;
        let activeMaxPrice = null;
        let activeAvail = null;

        // Mobile Collapsible Filters & Categories Bar
        const mobFilterBtn = document.getElementById('AtelierMobileFilterBtn');
        const mobFilterContent = document.getElementById('AtelierMobileFilterContent');
        const mobFilterBadge = document.getElementById('AtelierFilterCountBadge');

        if (mobFilterBtn && mobFilterContent) {
          mobFilterBtn.addEventListener('click', function(e) {
            e.preventDefault();
            const isOpen = mobFilterContent.classList.contains('is-open');
            if (isOpen) {
              mobFilterContent.classList.remove('is-open');
              mobFilterBtn.setAttribute('aria-expanded', 'false');
            } else {
              mobFilterContent.classList.add('is-open');
              mobFilterBtn.setAttribute('aria-expanded', 'true');
            }
          });
        }

        // On mobile (< 750px): auto switch 3-col default to 2-col, and collapse details accordions
        if (window.innerWidth < 750) {
          const btn2 = document.querySelector('.atelier-view-btn[data-view="2"]');
          const btn3 = document.querySelector('.atelier-view-btn[data-view="3"]');
          if (btn3 && btn3.classList.contains('is-active') && btn2) {
            btn3.classList.remove('is-active');
            btn2.classList.add('is-active');
            grid.classList.remove('view-mode-3');
            grid.classList.add('view-mode-2');
          }
          if (mobFilterContent) {
            mobFilterContent.querySelectorAll('details.atelier-filter-group').forEach(d => {
              d.removeAttribute('open');
            });
          }
        }

        // 1. View Switcher
        viewBtns.forEach(btn => {
          btn.addEventListener('click', function() {
            const view = this.getAttribute('data-view');
            viewBtns.forEach(b => b.classList.remove('is-active'));
            this.classList.add('is-active');

            grid.classList.remove('view-mode-1', 'view-mode-2', 'view-mode-3', 'view-mode-4');
            grid.classList.add(`view-mode-${view}`);
          });
        });

        const initialSortVal = sortSelect ? sortSelect.value : 'title-ascending';
        let currentSortMode = initialSortVal;

        function sortGrid(sortBy) {
          const itemArr = Array.from(items);
          if (sortBy === 'created-descending') {
            itemArr.sort((a, b) => {
              const dA = parseInt(a.getAttribute('data-product-created') || '0', 10);
              const dB = parseInt(b.getAttribute('data-product-created') || '0', 10);
              if (dB !== dA) return dB - dA;
              const idA = parseInt(a.getAttribute('data-product-id') || '0', 10);
              const idB = parseInt(b.getAttribute('data-product-id') || '0', 10);
              return idB - idA;
            });
          } else if (sortBy === 'created-ascending') {
            itemArr.sort((a, b) => {
              const dA = parseInt(a.getAttribute('data-product-created') || '0', 10);
              const dB = parseInt(b.getAttribute('data-product-created') || '0', 10);
              if (dA !== dB) return dA - dB;
              const idA = parseInt(a.getAttribute('data-product-id') || '0', 10);
              const idB = parseInt(b.getAttribute('data-product-id') || '0', 10);
              return idA - idB;
            });
          } else if (sortBy === 'price-ascending') {
            itemArr.sort((a, b) => {
              const pA = parseFloat(a.getAttribute('data-product-price') || '0');
              const pB = parseFloat(b.getAttribute('data-product-price') || '0');
              return pA - pB;
            });
          } else if (sortBy === 'price-descending') {
            itemArr.sort((a, b) => {
              const pA = parseFloat(a.getAttribute('data-product-price') || '0');
              const pB = parseFloat(b.getAttribute('data-product-price') || '0');
              return pB - pA;
            });
          } else if (sortBy === 'title-ascending') {
            itemArr.sort((a, b) => {
              const tA = (a.getAttribute('data-product-title') || '').toLowerCase();
              const tB = (b.getAttribute('data-product-title') || '').toLowerCase();
              return tA.localeCompare(tB);
            });
          } else if (sortBy === 'title-descending') {
            itemArr.sort((a, b) => {
              const tA = (a.getAttribute('data-product-title') || '').toLowerCase();
              const tB = (b.getAttribute('data-product-title') || '').toLowerCase();
              return tB.localeCompare(tA);
            });
          } else {
            itemArr.sort((a, b) => {
              const iA = parseInt(a.getAttribute('data-original-index') || '0', 10);
              const iB = parseInt(b.getAttribute('data-original-index') || '0', 10);
              return iA - iB;
            });
          }

          itemArr.forEach(node => grid.appendChild(node));
        }

        // Ensure empty message is strictly hidden on load
        if (emptyMsg) {
          emptyMsg.style.display = 'none';
        }

        // 2. Filter Function
        function applyFilters() {
          let visibleCount = 0;
          let hasActiveFilter = (activeColor !== '') || (activeMinPrice !== null) || (activeMaxPrice !== null) || (activeAvail !== null);

          if (currentSortMode !== initialSortVal) {
            sortGrid(currentSortMode);
            if (sortSelect) sortSelect.value = currentSortMode;
          }

          items.forEach(item => {
            let show = true;
            const pColors = item.getAttribute('data-product-colors') || '';
            const pPrice = parseFloat(item.getAttribute('data-product-price') || '0');
            const pAvail = item.getAttribute('data-product-available');

            if (activeColor && !pColors.split(' ').includes(activeColor)) {
              show = false;
            }
            if (activeMinPrice !== null && pPrice < activeMinPrice) {
              show = false;
            }
            if (activeMaxPrice !== null && pPrice > activeMaxPrice) {
              show = false;
            }
            if (activeAvail !== null && pAvail !== activeAvail) {
              show = false;
            }

            if (show) {
              item.style.display = '';
              visibleCount++;
            } else {
              item.style.display = 'none';
            }
          });

          if (countEl) {
            countEl.textContent = `${visibleCount} products`;
          }

          if (activeBar) {
            activeBar.style.display = hasActiveFilter ? 'flex' : 'none';
          }

          if (mobFilterBadge) {
            let activeFilterCount = 0;
            if (activeColor !== '') activeFilterCount++;
            if (activeMinPrice !== null || activeMaxPrice !== null) activeFilterCount++;
            if (activeAvail !== null) activeFilterCount++;
            if (activeFilterCount > 0) {
              mobFilterBadge.textContent = `${activeFilterCount} active`;
              mobFilterBadge.style.display = 'inline-block';
            } else {
              mobFilterBadge.style.display = 'none';
            }
          }

          if (emptyMsg) {
            emptyMsg.style.display = (hasActiveFilter && visibleCount === 0) ? 'block' : 'none';
          }
        }

        // 3. Collections Navigation (100% Real Shopify Collection URLs)
        typeItems.forEach(item => {
          item.addEventListener('click', function(e) {
            const targetUrl = this.getAttribute('data-url');
            if (targetUrl && !e.target.closest('a')) {
              window.location.href = targetUrl;
            }
          });
        });

        // 4. Color Select
        if (colorSelect) {
          colorSelect.addEventListener('change', function() {
            activeColor = this.value;
            applyFilters();
          });
        }

        // 5. Price Filter
        function handlePriceApply() {
          const minVal = minPriceInput ? parseFloat(minPriceInput.value) : NaN;
          const maxVal = maxPriceInput ? parseFloat(maxPriceInput.value) : NaN;
          activeMinPrice = !isNaN(minVal) ? minVal : null;
          activeMaxPrice = !isNaN(maxVal) ? maxVal : null;
          applyFilters();
        }

        if (priceApplyBtn) {
          priceApplyBtn.addEventListener('click', handlePriceApply);
        }
        if (minPriceInput) {
          minPriceInput.addEventListener('keypress', function(e) { if (e.key === 'Enter') handlePriceApply(); });
        }
        if (maxPriceInput) {
          maxPriceInput.addEventListener('keypress', function(e) { if (e.key === 'Enter') handlePriceApply(); });
        }

        // 6. Availability Filter
        availItems.forEach(item => {
          item.addEventListener('click', function() {
            const val = this.getAttribute('data-avail');
            if (this.classList.contains('is-active')) {
              this.classList.remove('is-active');
              activeAvail = null;
            } else {
              availItems.forEach(i => i.classList.remove('is-active'));
              this.classList.add('is-active');
              activeAvail = val;
            }
            applyFilters();
          });
        });

        // 7. Clear All
        function clearAll() {
          activeColor = '';
          activeMinPrice = null;
          activeMaxPrice = null;
          activeAvail = null;
          currentSortMode = initialSortVal;

          availItems.forEach(i => i.classList.remove('is-active'));
          if (colorSelect) colorSelect.value = '';
          if (minPriceInput) minPriceInput.value = '';
          if (maxPriceInput) maxPriceInput.value = '';

          sortGrid('original');
          if (sortSelect) sortSelect.value = initialSortVal;
          if (mobFilterBadge) mobFilterBadge.style.display = 'none';

          applyFilters();
        }

        if (clearAllBtn) clearAllBtn.addEventListener('click', clearAll);
        if (resetBtn) resetBtn.addEventListener('click', clearAll);

        // 8. Sorting
        if (sortSelect) {
          sortSelect.addEventListener('change', function() {
            const isAllPage = window.location.pathname.endsWith('/collections/all') || 
                              window.location.pathname.endsWith('/collections/all/') || 
                              window.location.pathname === '/collections' ||
                              window.location.pathname === '/collections/';
            if (isAllPage) {
              currentSortMode = this.value;
              sortGrid(this.value);
            } else {
              const url = new URL(window.location.href);
              url.searchParams.set('sort_by', this.value);
              window.location.href = url.toString();
            }
          });
        }

        // Auto-hide empty review badges or 0 reviews
        function hideEmptyReviewBadges() {
          document.querySelectorAll('.card-product__rating-box').forEach(function(box) {
            const badge = box.querySelector('.jdgm-prev-badge');
            if (badge) {
              const num = badge.getAttribute('data-number-of-reviews');
              const text = (badge.innerText || badge.textContent || '').trim().toLowerCase();
              if (num === '0' || text === 'no reviews' || text === '0 reviews' || text === '') {
                box.style.setProperty('display', 'none', 'important');
                box.style.setProperty('margin', '0', 'important');
                box.style.setProperty('height', '0', 'important');
                box.style.setProperty('min-height', '0', 'important');
                box.style.setProperty('padding', '0', 'important');
              }
            }
          });
        }
        hideEmptyReviewBadges();
        document.addEventListener('jdgm.doneSetup', hideEmptyReviewBadges);
        window.addEventListener('load', hideEmptyReviewBadges);
        setTimeout(hideEmptyReviewBadges, 800);
        setTimeout(hideEmptyReviewBadges, 2000);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAtelierFilters);
      } else {
        initAtelierFilters();
      }
    })();
  </script>
  {% if section.settings.image_shape == 'arch' %}
    {% render 'mask-arch' %}
  {%- endif -%}
</div>


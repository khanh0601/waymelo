<section class="wm-home wm-home__section" aria-labelledby="WaymeloCategoriesTitle-{{ section.id }}">
  <div class="wm-home__shell">
    <div class="wm-home__section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="wm-home__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="wm-home__heading" id="WaymeloCategoriesTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>

    <div class="wm-category-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign featured_collection = block.settings.collection
          assign fallback_product = block.settings.fallback_product
          assign card_image = block.settings.image
          if card_image == blank and featured_collection != blank
            assign card_image = featured_collection.image | default: featured_collection.products.first.featured_image
          endif
          if card_image == blank and fallback_product != blank
            assign card_image = fallback_product.featured_image
          endif
          assign card_title = block.settings.title
          if card_title == blank and featured_collection != blank
            assign card_title = featured_collection.title
          endif
          if card_title == blank and fallback_product != blank
            assign card_title = fallback_product.title
          endif
          assign card_url = featured_collection.url
          if card_url == blank
            assign card_url = block.settings.link
          endif
          assign card_url = card_url | default: routes.collections_url
          assign card_alt = card_image.alt | default: card_title
        -%}
        <a class="wm-category-card" href="{{ card_url }}" {{ block.shopify_attributes }}>
          <div class="wm-category-card__media">
            {%- if card_image != blank -%}
              {{
                card_image
                | image_url: width: 1000
                | image_tag:
                  class: 'wm-category-card__image',
                  widths: '320, 480, 640, 800, 1000',
                  sizes: '(min-width: 990px) 31vw, (min-width: 750px) 50vw, 44vw',
                  loading: 'lazy',
                  alt: card_alt
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="wm-category-card__copy">
            <h3 class="wm-category-card__title">{{ card_title | default: 'Collection' | escape }}</h3>
            {%- if block.settings.text != blank -%}<p class="wm-category-card__text">{{ block.settings.text | escape }}</p>{%- endif -%}
            <span class="wm-category-card__link">{{ block.settings.link_label | escape }} <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Waymelo categories",
  "tag": "section",
  "class": "section-waymelo-categories",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your kind of comfort" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "product", "id": "fallback_product", "label": "Fallback product image", "info": "Uses only this product's image until a collection is selected." },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "text", "label": "Description", "default": "Thoughtful essentials for easier days." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore category" },
        { "type": "url", "id": "link", "label": "Category link fallback", "info": "Used only when no collection is selected." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Waymelo categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}
  theme-check-disable ValidScopedCSSClass, LiquidComplexity
  © BlockyApps. You are permitted to use this content within your store. Redistribution or use in any other application is strictly prohibited.
  Unauthorized copying, distribution, or reproduction in any form will result in legal action.
{% endcomment %}

{%- assign bky_has_psr = section.blocks | where: 'type', 'product-server-rating' -%}
{%- if bky_has_psr.size > 0 -%}
  <script src="{{ 'product-server-rating.js' | asset_url }}" defer></script>
{%- endif -%}

{%- liquid
  assign current_template_product = product
  assign selected_product = section.settings.product

  if section.settings.product_source == 'current' and current_template_product != blank
    assign product = current_template_product
  else
    assign product = selected_product
  endif

  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign current_variant = product.selected_or_first_available_variant
  assign initial_media = current_variant.featured_media | default: product.featured_media

  assign media_ratio = '1 / 1'
  case section.settings.media_aspect_ratio
    when 'adapt'
      if initial_media.preview_image
        assign media_ratio = initial_media.preview_image.aspect_ratio
      endif
    when 'portrait'
      assign media_ratio = '4 / 5'
    when 'landscape'
      assign media_ratio = '4 / 3'
  endcase

  assign product_form_id = 'blocky-product-form-' | append: section.id
-%}

{%- assign bky_has_iwt = section.blocks | where: 'type', 'icon-with-text' -%}
{%- assign bky_has_comp = section.blocks | where: 'type', 'complementary' -%}
{%- assign bky_has_collapsible = section.blocks | where: 'type', 'collapsible_tab' -%}
{%- assign bky_has_rti = section.blocks | where: 'type', 'rating_text_icon' -%}
{%- assign bky_has_rs = section.blocks | where: 'type', 'review-stars' -%}
{%- assign bky_has_acc = section.blocks | where: 'type', 'accordion' -%}
{%- if bky_has_iwt.size > 0 or bky_has_comp.size > 0 or bky_has_collapsible.size > 0 or bky_has_rti.size > 0 or bky_has_rs.size > 0 or bky_has_acc.size > 0 -%}
{%- endif -%}

{% render 'blocky-main-product-css', section: section %}

<blocky-featured-product
  id="blocky-featured-product-{{ section.id }}"
  class="blocky-featured-product-scope blocky blocky-featured-product blocky-padding background-wrapper"
>
  <div class="blocky-page-width">
    <div class="blocky-flex-container blocky-mob-flex-col blocky-des-flex-{% if section.settings.media_position == 'right' %}row-reverse{% else %}row{% endif %}">
      <div class="blocky-flex-child blocky-featured-product__media-col">
        <div>
          <div
            class="blocky-featured-product__media-wrap blocky-media-adapt is-loading"
            style="--bky-media-ratio: {{ media_ratio }}"
          >
            <div class="blocky-featured-product__main">
              {%- if product != blank and product.media.size > 0 -%}
                {%- for media in product.media -%}
                  <div
                    class="blocky-featured-product__media{% if media.id == initial_media.id %} is-active{% endif %}"
                    data-blocky-product-media="{{ media.id }}"
                  >
                    {%- liquid
                      assign media_alt = media.alt | default: product.title
                      assign media_loading = 'lazy'
                      assign media_fetchpriority = 'low'
                      assign media_preload = false
                      if media.id == initial_media.id
                        assign media_loading = 'eager'
                        assign media_fetchpriority = 'high'
                        assign media_preload = true
                      endif
                    -%}
                    {{
                      media.preview_image
                      | image_url: width: 1400
                      | image_tag:
                        widths: '360, 480, 600, 750, 900, 1200, 1400',
                        sizes: '(min-width: 1264px) 520px, (min-width: 990px) 46vw, calc(100vw - 30px)',
                        alt: media_alt,
                        loading: media_loading,
                        fetchpriority: media_fetchpriority,
                        preload: media_preload
                    }}
                  </div>
                {%- endfor -%}
              {%- else -%}
                <div class="blocky-featured-product__media is-active">
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>
          </div>

          {%- if product != blank and product.media.size > 1 -%}
            {%- if section.settings.thumbnail_layout == 'carousel' -%}
              {%- liquid
                assign visible_thumbnail_count = section.settings.thumbnail_slides_per_column | default: 4
                assign rendered_thumbnail_count = visible_thumbnail_count
                if product.media.size < rendered_thumbnail_count
                  assign rendered_thumbnail_count = product.media.size
                endif
                assign thumbnail_gap = 10
                assign thumbnail_gap_total = rendered_thumbnail_count | minus: 1 | times: thumbnail_gap
                assign thumbnail_half_gap = thumbnail_gap | divided_by: 2.0
              -%}
              <blocky-media-slider
                class="blocky-featured-product__thumb-slider glide ivs-{{ section.id }}-thumbs is-loading"
                data-id="{{ section.id }}-thumbs"
                data-size="{{ product.media.size }}"
                slide-size="{{ visible_thumbnail_count }}"
                mobile-slide-size="{{ visible_thumbnail_count }}"
                media-spacing="{{ thumbnail_gap }}"
                data-anim-duration="350"
                style="--bky-thumb-width: calc((100% - {{ thumbnail_gap_total }}px) / {{ rendered_thumbnail_count }}); --bky-thumb-half-gap: {{ thumbnail_half_gap }}px;"
              >
                <div class="glide__track" data-glide-el="track">
                  <ul class="glide__slides blocky-featured-product__thumbs blocky-featured-product__thumbs--carousel" aria-label="Product media thumbnails">
                    {%- for media in product.media -%}
                      <li class="glide__slide">
                        <button
                          type="button"
                          class="blocky-featured-product__thumb{% if media.id == initial_media.id %} is-active{% endif %}"
                          data-blocky-product-thumb="{{ media.id }}"
                          aria-label="Show image {{ forloop.index }}"
                          aria-current="{% if media.id == initial_media.id %}true{% else %}false{% endif %}"
                        >
                          <img
                            src="{{ media.preview_image | image_url: width: 180 }}"
                            alt="{{ media.alt | default: product.title | escape }}"
                            loading="lazy"
                            width="90"
                            height="90"
                          >
                        </button>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
                {%- if product.media.size > visible_thumbnail_count -%}
                  <div class="glide__arrows" data-glide-el="controls">
                    <button type="button" class="glide__arrow glide__arrow--prev blocky-featured-product__thumb-nav blocky-featured-product__thumb-nav--prev" data-glide-dir="<" aria-label="Previous thumbnails">&#8249;</button>
                    <button type="button" class="glide__arrow glide__arrow--next blocky-featured-product__thumb-nav blocky-featured-product__thumb-nav--next" data-glide-dir=">" aria-label="Next thumbnails">&#8250;</button>
                  </div>
                {%- endif -%}
              </blocky-media-slider>
            {%- else -%}
              <div class="blocky-featured-product__thumbs blocky-featured-product__thumbs--stack" aria-label="Product media thumbnails">
                {%- for media in product.media -%}
                  <button
                    type="button"
                    class="blocky-featured-product__thumb{% if media.id == initial_media.id %} is-active{% endif %}"
                    data-blocky-product-thumb="{{ media.id }}"
                    aria-label="Show image {{ forloop.index }}"
                    aria-current="{% if media.id == initial_media.id %}true{% else %}false{% endif %}"
                  >
                    <img
                      src="{{ media.preview_image | image_url: width: 180 }}"
                      alt="{{ media.alt | default: product.title | escape }}"
                      loading="lazy"
                      width="90"
                      height="90"
                    >
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'before_after_block' -%}
              <div
                class="before_after_dual_btn_wrapper"
                style="--bky-before-after-bg: {{ block.settings.btn_bg_color }}; --bky-before-after-text: {{ block.settings.btn_text_color }}; --bky-divider-color: {{ block.settings.divider_color }}; --icon-size: {{ block.settings.icon_size }}px;"
                {{ block.shopify_attributes }}
              >
                <div class="showup">
                  <button class="before_after_btn before" type="button" data-index="{{ block.settings.before_slide_index | minus: 1 }}">
                    {%- if block.settings.before_icon != blank -%}
                      {{ block.settings.before_icon | image_url: width: 60 | image_tag: class: 'custom-btn-icon', loading: 'lazy' }}
                    {%- endif -%}
                    <span class="btn_text">{{ block.settings.before_label }}</span>
                  </button>

                  <button class="before_after_btn after" type="button" data-index="{{ block.settings.after_slide_index | minus: 1 }}">
                    {%- if block.settings.after_icon != blank -%}
                      {{ block.settings.after_icon | image_url: width: 60 | image_tag: class: 'custom-btn-icon', loading: 'lazy' }}
                    {%- endif -%}
                    <span class="btn_text">{{ block.settings.after_label }}</span>
                  </button>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'product_reviews' and block.settings.show_on_left -%}
              {%- assign rendered_review_count = 0 -%}
              {%- for i in (1..3) -%}
                {%- liquid
                  assign reviewer_key = 'reviewer_' | append: i
                  assign text_key = 'text_' | append: i
                  assign reviewer = block.settings[reviewer_key]
                  assign review_text = block.settings[text_key]
                -%}
                {%- if reviewer != blank or review_text != blank -%}
                  {%- assign rendered_review_count = rendered_review_count | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
              <div class="blocky-product-reviews-outer{% if block.settings.product_reviews_card %} blocky-pdr-card{% endif %}">
              <blocky-media-slider
                class="blocky-product-reviews blocky-product-reviews--left glide ivs-{{ section.id }}-{{ block.id }}"
                data-id="{{ section.id }}-{{ block.id }}"
                data-size="{{ rendered_review_count }}"
                slide-size="1"
                mobile-slide-size="1"
                media-spacing="0"
                data-anim-duration="350"
                style="--bky-review-image-size: {{ block.settings.product_reviews_image_size }}px; --bky-review-card-padding-block: {% if block.settings.product_reviews_card %}1.1rem{% else %}0{% endif %}; --bky-review-card-padding-inline: {% if block.settings.product_reviews_card %}2.6rem{% else %}0{% endif %}; --bky-review-card-color: {% if block.settings.product_reviews_card %}{{ block.settings.product_reviews_card_color }}{% else %}transparent{% endif %};"
                {{ block.shopify_attributes }}
              >
                <div class="glide__track" data-glide-el="track">
                  <ul class="glide__slides">
                    {%- for i in (1..3) -%}
                      {%- liquid
                        assign reviewer_key = 'reviewer_' | append: i
                        assign text_key = 'text_' | append: i
                        assign image_key = 'image_' | append: i
                        assign reviewer = block.settings[reviewer_key]
                        assign review_text = block.settings[text_key]
                        assign review_image = block.settings[image_key]
                      -%}
                      {%- if reviewer != blank or review_text != blank -%}
                        <li class="glide__slide">
                          <div class="blocky-product-review">
                            {%- if review_image != blank or block.settings.show_placeholder_image -%}
                              <div class="blocky-product-review__image blocky-product-review__image-{{ block.settings.image_shape }}">
                                {%- if review_image != blank -%}
                                  <img src="{{ review_image | image_url: width: 300 }}" alt="{{ reviewer | strip_html | escape }}" loading="lazy" width="300" height="300">
                                {%- else -%}
                                  {{ 'image' | placeholder_svg_tag }}
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                            <div
                              class="blocky-product-review__content"
                              style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.text_size }}px; text-align: {{ block.settings.text_alignment }}; --review-text-size: {{ block.settings.text_size }}px; --review-reviewer-size: {{ block.settings.reviewer_text_size }}px; --review-star-color: {{ block.settings.star_color }}; --review-star-size: {{ block.settings.star_size }}px;{% if block.settings.line_height > 0 %} --bky-lh: {{ block.settings.line_height }};{% endif %}{% if block.settings.letter_spacing != 0 %} --bky-ls: {{ block.settings.letter_spacing }}px;{% endif %}"
                            >
                              <div class="blocky-product-review__text">{{ review_text }}</div>
                              <div class="blocky-product-review__reviewer">{{ reviewer }}</div>
                              {%- if block.settings.display_stars -%}
                                <div class="blocky-product-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                              {%- endif -%}
                            </div>
                          </div>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
                {%- if rendered_review_count > 1 -%}
                  <div class="glide__arrows" data-glide-el="controls">
                    <button type="button" class="glide__arrow glide__arrow--prev blocky-product-review__nav blocky-product-review__nav--prev" data-glide-dir="<" aria-label="Previous review">&#8249;</button>
                    <button type="button" class="glide__arrow glide__arrow--next blocky-product-review__nav blocky-product-review__nav--next" data-glide-dir=">" aria-label="Next review">&#8250;</button>
                  </div>
                {%- endif -%}
              </blocky-media-slider>
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'product_reviews_2' and block.settings.show_on_left -%}
              {%- assign rendered_review_count = 0 -%}
              {%- for i in (1..3) -%}
                {%- liquid
                  assign reviewer_key = 'reviewer_' | append: i
                  assign text_key = 'text_' | append: i
                  assign reviewer = block.settings[reviewer_key]
                  assign review_text = block.settings[text_key]
                -%}
                {%- if reviewer != blank or review_text != blank -%}
                  {%- assign rendered_review_count = rendered_review_count | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
              {%- capture pr2_star_filled -%}<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 1.5L14.41 8.68L21.99 8.76L15.9 13.27L18.17 20.49L12 16.1L5.83 20.49L8.1 13.27L2.01 8.76L9.59 8.68Z"></path></svg>{%- endcapture -%}
              {%- capture pr2_style -%}--pr2-bg-color: {{ block.settings.card_bg_color }}; --pr2-border-color: {{ block.settings.card_border_color }}; --pr2-radius: {{ block.settings.card_border_radius }}px; --pr2-accent-color: {{ block.settings.accent_color }}; --pr2-bar-color: {{ block.settings.bar_color }}; --pr2-star-color: {{ block.settings.star_color }}; --pr2-star-size: {{ block.settings.star_size }}px; --pr2-heading-color: {{ block.settings.heading_color }}; --pr2-heading-size: {{ block.settings.heading_size }}px; --pr2-text-color: {{ block.settings.text_color }}; --pr2-text-size: {{ block.settings.text_size }}px; --pr2-reviewer-color: {{ block.settings.reviewer_color }}; --pr2-reviewer-size: {{ block.settings.reviewer_text_size }}px; --pr2-avatar-size: {{ block.settings.avatar_size }}px; --pr2-avatar-border-width: {{ block.settings.avatar_border_width }}px; --pr2-verified-size: {{ block.settings.verified_text_size }}px;{%- endcapture -%}
              <div class="blocky-product-reviews-outer blocky-pr2-outer blocky-pr2-outer--left{% if block.settings.hide_on_mobile %} blocky-pr2-hide-mobile{% endif %}">
              {%- if rendered_review_count > 1 -%}
              <blocky-media-slider
                class="blocky-product-reviews blocky-pr2 blocky-product-reviews--left glide ivs-{{ section.id }}-{{ block.id }}"
                data-id="{{ section.id }}-{{ block.id }}"
                data-size="{{ rendered_review_count }}"
                slide-size="1"
                mobile-slide-size="1"
                media-spacing="0"
                data-anim-duration="350"
                style="{{ pr2_style }}"
                {{ block.shopify_attributes }}
              >
                <div class="glide__track" data-glide-el="track">
                  <ul class="glide__slides">
                    {%- for i in (1..3) -%}
                      {%- liquid
                        assign reviewer_key = 'reviewer_' | append: i
                        assign text_key = 'text_' | append: i
                        assign image_key = 'image_' | append: i
                        assign heading_key = 'heading_' | append: i
                        assign reviewer = block.settings[reviewer_key]
                        assign review_text = block.settings[text_key]
                        assign review_image = block.settings[image_key]
                        assign review_heading = block.settings[heading_key]
                      -%}
                      {%- if reviewer != blank or review_text != blank -%}
                        <li class="glide__slide">
                          <div class="blocky-pr2-card">
                            {%- if block.settings.display_stars -%}
                              <div class="blocky-pr2-stars" aria-hidden="true">
                                {{ pr2_star_filled }}{{ pr2_star_filled }}{{ pr2_star_filled }}{{ pr2_star_filled }}{{ pr2_star_filled }}
                              </div>
                            {%- endif -%}
                            {%- if review_heading != blank -%}
                              <p class="blocky-pr2-heading">{{ review_heading }}</p>
                            {%- endif -%}
                            {%- if review_text != blank -%}
                              <div class="blocky-pr2-text">{{ review_text }}</div>
                            {%- endif -%}
                            <div class="blocky-pr2-footer">
                              {%- if review_image != blank or block.settings.show_placeholder_image -%}
                                <div class="blocky-pr2-avatar">
                                  {%- if review_image != blank -%}
                                    <img src="{{ review_image | image_url: width: 200 }}" alt="{{ reviewer | strip_html | escape }}" loading="lazy" width="200" height="200">
                                  {%- else -%}
                                    {{ 'image' | placeholder_svg_tag }}
                                  {%- endif -%}
                                </div>
                              {%- endif -%}
                              <div class="blocky-pr2-meta">
                                {%- if reviewer != blank -%}<div class="blocky-pr2-reviewer">{{ reviewer }}</div>{%- endif -%}
                                {%- if block.settings.show_verified -%}
                                  <div class="blocky-pr2-verified">
                                    <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2l2.39 2.39 3.3-.6.6 3.3L20.68 9l-1.79 2.7L20.68 15l-2.39 1.91-.6 3.3-3.3-.6L12 22l-2.39-2.39-3.3.6-.6-3.3L3.32 15l1.79-2.7L3.32 9l2.39-1.91.6-3.3 3.3.6L12 2z"></path><path d="M9.5 12.5l1.8 1.8 3.2-3.6" stroke="#fff" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                                    <span>{{ block.settings.verified_text }}</span>
                                  </div>
                                {%- endif -%}
                              </div>
                            </div>
                          </div>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
                {%- unless block.settings.hide_arrows -%}
                  <div class="glide__arrows" data-glide-el="controls">
                    <button type="button" class="glide__arrow glide__arrow--prev blocky-product-review__nav blocky-product-review__nav--prev" data-glide-dir="<" aria-label="Previous review">&#8249;</button>
                    <button type="button" class="glide__arrow glide__arrow--next blocky-product-review__nav blocky-product-review__nav--next" data-glide-dir=">" aria-label="Next review">&#8250;</button>
                  </div>
                {%- endunless -%}
              </blocky-media-slider>
              {%- else -%}
                <div class="blocky-pr2-single" style="{{ pr2_style }}" {{ block.shopify_attributes }}>
                  {%- for i in (1..3) -%}
                    {%- liquid
                      assign reviewer_key = 'reviewer_' | append: i
                      assign text_key = 'text_' | append: i
                      assign image_key = 'image_' | append: i
                      assign heading_key = 'heading_' | append: i
                      assign reviewer = block.settings[reviewer_key]
                      assign review_text = block.settings[text_key]
                      assign review_image = block.settings[image_key]
                      assign review_heading = block.settings[heading_key]
                    -%}
                    {%- if reviewer != blank or review_text != blank -%}
                      <div class="blocky-pr2-card">
                        {%- if block.settings.display_stars -%}
                          <div class="blocky-pr2-stars" aria-hidden="true">
                            {{ pr2_star_filled }}{{ pr2_star_filled }}{{ pr2_star_filled }}{{ pr2_star_filled }}{{ pr2_star_filled }}
                          </div>
                        {%- endif -%}
                        {%- if review_heading != blank -%}
                          <p class="blocky-pr2-heading">{{ review_heading }}</p>
                        {%- endif -%}
                        {%- if review_text != blank -%}
                          <div class="blocky-pr2-text">{{ review_text }}</div>
                        {%- endif -%}
                        <div class="blocky-pr2-footer">
                          {%- if review_image != blank or block.settings.show_placeholder_image -%}
                            <div class="blocky-pr2-avatar">
                              {%- if review_image != blank -%}
                                <img src="{{ review_image | image_url: width: 200 }}" alt="{{ reviewer | strip_html | escape }}" loading="lazy" width="200" height="200">
                              {%- else -%}
                                {{ 'image' | placeholder_svg_tag }}
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                          <div class="blocky-pr2-meta">
                            {%- if reviewer != blank -%}<div class="blocky-pr2-reviewer">{{ reviewer }}</div>{%- endif -%}
                            {%- if block.settings.show_verified -%}
                              <div class="blocky-pr2-verified">
                                <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2l2.39 2.39 3.3-.6.6 3.3L20.68 9l-1.79 2.7L20.68 15l-2.39 1.91-.6 3.3-3.3-.6L12 22l-2.39-2.39-3.3.6-.6-3.3L3.32 15l1.79-2.7L3.32 9l2.39-1.91.6-3.3 3.3.6L12 2z"></path><path d="M9.5 12.5l1.8 1.8 3.2-3.6" stroke="#fff" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                                <span>{{ block.settings.verified_text }}</span>
                              </div>
                            {%- endif -%}
                          </div>
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="blocky-flex-child blocky-featured-product__content-col">
        <div class="blocky-featured-product__content blocky-media-text-container blocky-text-container-desktop-{{ section.settings.desktop_content_alignment }} blocky-text-container-mobile-{{ section.settings.mobile_content_alignment }}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {%- if block.id contains 'pumper_bundles' -%}
                  {%- capture pumper_block_markup -%}{% render block %}{%- endcapture -%}
                  {%- liquid
                    assign pumper_item_count = 0
                    assign pumper_count_marker = 'name="prvw_length_bar"'

                    if pumper_block_markup contains pumper_count_marker
                      assign pumper_count_tail = pumper_block_markup | split: pumper_count_marker | last
                      assign pumper_count_parts = pumper_count_tail | split: 'value="'
                      assign pumper_item_count = pumper_count_parts[1] | split: '"' | first | plus: 0
                    endif
                  -%}
                  {%- if pumper_item_count > 0 -%}
                    <div
                      class="blocky-app-slot blocky-app-slot--pumper is-loading"
                      data-blocky-pumper-slot
                      data-blocky-pumper-count="{{ pumper_item_count }}"
                      aria-busy="true"
                    >
                      <div class="blocky-pumper-skeleton" aria-hidden="true">
                        <span class="blocky-pumper-skeleton__title"></span>

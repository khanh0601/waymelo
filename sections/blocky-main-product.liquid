                                <span class="blocky-pumper-skeleton__line blocky-pumper-skeleton__line--subtitle"></span>
                              </span>
                              <span class="blocky-pumper-skeleton__price"></span>
                            </div>
                          {%- endfor -%}
                        </div>
                      </div>
                      {{ pumper_block_markup }}
                      <script>
                        (() => {
                          const mountSelector = {{ '#blocky-featured-product-' | append: section.id | append: ' [data-blocky-pumper-slot] pumper-bundle' | json }};
                          const formSelector = {{ '#' | append: product_form_id | json }};

                          document.querySelectorAll('[id="prvw_custom_var_selector"]').forEach((input) => {
                            input.value = mountSelector;
                          });
                          document.querySelectorAll('[id="prvw_custom_form_selector"]').forEach((input) => {
                            input.value = formSelector;
                          });
                        })();
                      </script>
                    </div>
                  {%- endif -%}
                {%- else -%}
                  {% render block %}
                {%- endif -%}
              {%- when 'shipping-checkpoints' -%}

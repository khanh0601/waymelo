                  class="blocky blocky-shipping-checkpoints"
                  style="--text-size: {{ block.settings.text_size }};{% if block.settings.line_height > 0 %} --bky-lh: {{ block.settings.line_height }};{% endif %}{% if block.settings.letter_spacing != 0 %} --bky-ls: {{ block.settings.letter_spacing }}px;{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <div class="blocky-shipping-checkpoint-line"></div>
                  {%- for i in (1..4) -%}
                    {%- liquid
                      assign image_key = 'image_' | append: i
                      assign text_key = 'text_' | append: i
                      assign start_key = 'start_date_' | append: i
                      assign end_key = 'end_date_' | append: i
                      assign start_date_seconds = block.settings[start_key] | times: 86400
                      assign end_date_seconds = block.settings[end_key] | times: 86400
                      assign start_date = "now" | date: "%s" | plus: start_date_seconds | date: "%b %e"
                      assign end_date = "now" | date: "%s" | plus: end_date_seconds | date: "%b %e"

                {%- capture rs_star_fill -%}<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 1.5L14.41 8.68L21.99 8.76L15.9 13.27L18.17 20.49L12 16.1L5.83 20.49L8.1 13.27L2.01 8.76L9.59 8.68Z"></path></svg>{%- endcapture -%}
                <div
                  class="product-review-stars"
                  style="justify-content: {{ block.settings.review_alignment }}; --rating: {{ block.settings.rating }}; --star-color: {{ block.settings.star_color }}; --font-size: {{ block.settings.review_font_size }}px; --rs-badge-bg-color: {{ block.settings.badge_bg_color }}; --rs-badge-text-color: {{ block.settings.badge_text_color }}; --rs-badge-text-size: {{ block.settings.badge_text_size }}px;"
                  {{ block.shopify_attributes }}
                >
                  <div class="product-review-stars-container product-review-stars-container-underlay" aria-hidden="true">
                    {{ rs_star_outline }}{{ rs_star_outline }}{{ rs_star_outline }}{{ rs_star_outline }}{{ rs_star_outline }}
                    <div class="product-review-stars-container product-review-stars-container-overlay">
                      {{ rs_star_fill }}{{ rs_star_fill }}{{ rs_star_fill }}{{ rs_star_fill }}{{ rs_star_fill }}
                    </div>
                  </div>
                  <span class="product-review-stars-label" style="color: {{ block.settings.review_text_color }};{% if block.settings.line_height > 0 %} line-height: {{ block.settings.line_height }};{% endif %}{% if block.settings.letter_spacing != 0 %} letter-spacing: {{ block.settings.letter_spacing }}px;{% endif %}">{{ block.settings.review_text }}</span>
                  {%- if block.settings.show_badge and block.settings.badge_text != blank -%}
                    <span class="blocky-review-stars-badge">
                      {%- if block.settings.badge_icon_code != blank -%}
                        <span class="blocky-review-stars-badge-icon material-icons material-symbols-outlined">{{ block.settings.badge_icon_code }}</span>
                      {%- endif -%}
                      {{ block.settings.badge_text }}
                    </span>
                  {%- endif -%}
                </div>
              {%- when 'product-server-rating' -%}
                <div

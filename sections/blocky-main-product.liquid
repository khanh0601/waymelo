                          <div class="blocky-rti-stars-container blocky-rti-stars-overlay">
                            {{ rti_star_fill }}{{ rti_star_fill }}{{ rti_star_fill }}{{ rti_star_fill }}{{ rti_star_fill }}
                          </div>
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  <div class="blocky-rti-content">
                    {%- if block.settings.heading != blank -%}
                      <p class="blocky-rti-heading">{{ block.settings.heading }}</p>
                    {%- endif -%}
                    <div class="blocky-rti-features">
                      {%- for i in (1..3) -%}
                        {%- liquid
                          assign feature_key = 'feature_' | append: i
                          assign feature_text = block.settings[feature_key]
                          assign icon_key = 'feature_' | append: i | append: '_icon'
                          assign icon_img = block.settings[icon_key]
                          assign icon_code_key = 'feature_' | append: i | append: '_icon_code'
                          assign icon_code = block.settings[icon_code_key]
                        -%}
                        {%- if feature_text != blank -%}
                          <div class="blocky-rti-feature">
                            {%- if icon_img != blank -%}
                              <img class="blocky-rti-feature-icon" src="{{ icon_img | image_url: width: 100 }}" alt="" loading="lazy" width="{{ icon_img.width }}" height="{{ icon_img.height }}">

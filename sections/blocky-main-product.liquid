                  data-product-server-rating
                  aria-hidden="true"
                  {{ block.shopify_attributes }}
                >
                  <a class="product-server-rating" href="#trustshop-review">
                    <span class="product-server-rating__stars" style="--rating-percent: 0%;" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                    <p><span class="product-server-rating__count"></span> <span style="color: #000;">reviews</span></p>
                  </a>
                </div>
              {%- when 'rating_text_icon' -%}
                {%- capture rti_star_outline -%}<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 1.5L14.41 8.68L21.99 8.76L15.9 13.27L18.17 20.49L12 16.1L5.83 20.49L8.1 13.27L2.01 8.76L9.59 8.68Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="miter"></path></svg>{%- endcapture -%}
                {%- capture rti_star_fill -%}<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 1.5L14.41 8.68L21.99 8.76L15.9 13.27L18.17 20.49L12 16.1L5.83 20.49L8.1 13.27L2.01 8.76L9.59 8.68Z"></path></svg>{%- endcapture -%}
                <div
                  class="blocky-rti"
                  style="--rti-avatar-size: {{ block.settings.avatar_size }}px; --rti-avatar-border-color: {{ block.settings.avatar_border_color }}; --rti-avatar-border-width: {{ block.settings.avatar_border_width }}px; --rti-rating: {{ block.settings.rating }}; --rti-star-color: {{ block.settings.star_color }}; --rti-star-size: {{ block.settings.star_size }}px; --rti-heading-color: {{ block.settings.heading_color }}; --rti-heading-size: {{ block.settings.heading_size }}px; --rti-feature-icon-size: {{ block.settings.feature_icon_size }}px; --rti-feature-text-size: {{ block.settings.feature_text_size }}px; --rti-feature-text-color: {{ block.settings.feature_text_color }}; --rti-feature-gap: {{ block.settings.feature_icon_gap }}px;"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.avatar_1 != blank or block.settings.avatar_2 != blank or block.settings.avatar_3 != blank or block.settings.show_stars -%}
                    <div class="blocky-rti-avatars-col">
                      {%- if block.settings.avatar_1 != blank or block.settings.avatar_2 != blank or block.settings.avatar_3 != blank -%}
                        <div class="blocky-rti-avatars">
                          {%- if block.settings.avatar_1 != blank -%}
                            <div class="blocky-rti-avatar"><img src="{{ block.settings.avatar_1 | image_url: width: 200 }}" alt="" loading="lazy" width="{{ block.settings.avatar_1.width }}" height="{{ block.settings.avatar_1.height }}"></div>
                          {%- endif -%}
                          {%- if block.settings.avatar_2 != blank -%}
                            <div class="blocky-rti-avatar"><img src="{{ block.settings.avatar_2 | image_url: width: 200 }}" alt="" loading="lazy" width="{{ block.settings.avatar_2.width }}" height="{{ block.settings.avatar_2.height }}"></div>
                          {%- endif -%}
                          {%- if block.settings.avatar_3 != blank -%}
                            <div class="blocky-rti-avatar"><img src="{{ block.settings.avatar_3 | image_url: width: 200 }}" alt="" loading="lazy" width="{{ block.settings.avatar_3.width }}" height="{{ block.settings.avatar_3.height }}"></div>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                      {%- if block.settings.show_stars -%}
                        <div class="blocky-rti-stars-container blocky-rti-stars-underlay" aria-hidden="true">

{%- style -%}
  .blocky-scrolling-text-bar-{{ section.id }} {
    --bg-color: {{ section.settings.background_color | default: '#7a5168' }};
    --color: {{ section.settings.text_color | default: '#ffffff' }};
    --pad-top: {{ section.settings.padding_top | default: 16 }}px;
    --pad-bottom: {{ section.settings.padding_bottom | default: 16 }}px;
    --font-size: {{ section.settings.text_size | default: '1.75' }}rem;
    --space: {{ section.settings.text_spacing | default: 3 }};
    --ticker-duration: {% if section.settings.speed > 0 %}{{ 30 | divided_by: section.settings.speed }}{% else %}45{% endif %}s;

    background-color: var(--bg-color);
    color: var(--color);
    padding-top: var(--pad-top);
    padding-bottom: var(--pad-bottom);
    overflow: hidden;
    position: relative;
    width: 100%;
    line-height: 1.2;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .blocky-scrolling-text-bar-{{ section.id }}::-webkit-scrollbar,
  .blocky-scrolling-text-bar-{{ section.id }} *::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .blocky-scrolling-text-bar-{{ section.id }} .blocky-announcement-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: blockyMarquee-{{ section.id }} var(--ticker-duration) linear infinite;
    overflow: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .blocky-scrolling-text-bar-{{ section.id }}:hover .blocky-announcement-track {
    animation-play-state: paused;
  }

  .blocky-scrolling-text-bar-{{ section.id }} .blocky-announcement-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .blocky-scrolling-text-bar-{{ section.id }} .blocky-announcement-bar-text {
    margin: 0;
    padding: 0 calc(var(--space) * 0.75rem);
    font-size: var(--font-size);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: inherit;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  @keyframes blockyMarquee-{{ section.id }} {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media screen and (max-width: 749px) {
    .blocky-scrolling-text-bar-{{ section.id }} {
      padding-top: clamp(6px, 1.8vw, 10px);
      padding-bottom: clamp(6px, 1.8vw, 10px);
    }
    .blocky-scrolling-text-bar-{{ section.id }} .blocky-announcement-bar-text {
      font-size: clamp(0.78rem, 3.2vw, 0.95rem);
      padding: 0 clamp(0.85rem, 2.5vw, 1.35rem);
      font-weight: 600;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blocky-scrolling-text-bar-{{ section.id }} .blocky-announcement-track {
      animation: blockyMarquee-{{ section.id }} calc(var(--ticker-duration) * 2.5) linear infinite;
      overflow: hidden;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
  }
{%- endstyle -%}

{%- liquid
  assign block_count = section.blocks.size
  if block_count == 0
    assign block_count = 1
  endif
  assign repeat_count = 12 | divided_by: block_count | ceil
  if repeat_count < 2
    assign repeat_count = 2
  endif
-%}

{% comment %}theme-check-disable ValidScopedCSSClass{% endcomment %}
<div class="blocky blocky-announcement-bar blocky-scrolling-text-bar-{{ section.id }}" role="region" aria-label="Announcement ticker">
  <div class="blocky-announcement-track">
    <div class="blocky-announcement-group" aria-hidden="false">
      {%- for i in (1..repeat_count) -%}
        {%- for block in section.blocks -%}
          <p class="blocky-announcement-bar-text" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </p>
        {%- endfor -%}
      {%- endfor -%}
    </div>
    <div class="blocky-announcement-group" aria-hidden="true">
      {%- for i in (1..repeat_count) -%}
        {%- for block in section.blocks -%}
          <p class="blocky-announcement-bar-text">
            {{ block.settings.text }}
          </p>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BKY - Scrolling Text Bar",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        {
            "value": "1.25",
            "label": "Extra small"
        },
        {
            "value": "1.5",
            "label": "Small"
        },
        {
            "value": "1.75",
            "label": "Medium"
        },
        {
            "value": "2",
            "label": "Large"
        },
        {
            "value": "2.5",
            "label": "Extra large"
        }
      ],
      "default": "1.75"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },

    {
      "type": "range",
      "id": "speed",
      "label": "Ticker speed",
      "min": 0,
      "max": 5,
      "default": 1,
      "step": 0.5
    },
    {
      "type": "range",
      "id": "text_spacing",
      "label": "Text spacing",
      "min": 1,
      "max": 5,
      "default": 3,
      "step": 0.5
    },

    {
      "type": "header",
      "content": "Block Padding",
      "info": "Change the size of the announcement bar"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 16
    }
  ],
    "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Scrolling Text Bar",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blocky Scrolling Text Bar",
      "blocks": [
        {
            "type": "text"
        },
        {
            "type": "text"
        },
        {
            "type": "text"
        },
        {
            "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}

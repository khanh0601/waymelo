{%- liquid
  # Lazy HTML: for real visitors the whole section ships inside an inert <template>, so its
  # scripts, stylesheets and media do nothing until the loader in layout/theme.liquid activates
  # it (when the section comes within ~1200px of the viewport). Rendered normally in the theme
  # editor and when the section sits at the top of a page (section.index <= 2). Only sections
  # without SEO value use this.
  assign waymelo_lazy_html = true
  if request.design_mode
    assign waymelo_lazy_html = false
  endif
  if section.index == blank or section.index <= 2
    assign waymelo_lazy_html = false
  endif
  # Judge.me initialises its review widget once, when its embed script runs at page load.
  # A widget that is cloned into the page later is never styled and its spinner never
  # stops, so a section holding a Judge.me block is always rendered eagerly.
-%}
{%- capture waymelo_app_blocks -%}
  {%- for block in section.blocks -%}
    {% render block %}
  {%- endfor -%}
{%- endcapture -%}
{%- liquid
  # App blocks report block.type as '@app', so the rendered markup is inspected instead.
  if waymelo_app_blocks contains 'jdgm-'
    assign waymelo_lazy_html = false
  endif
-%}
{%- if waymelo_lazy_html -%}
  <div data-waymelo-lazy-placeholder style="min-height: 0px" aria-hidden="true"></div>
  <template data-waymelo-lazy-section>
{%- endif -%}
<div class="{% if section.settings.include_margins %}page-width{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  {{ waymelo_app_blocks }}
</div>

{%- if waymelo_lazy_html -%}
  </template>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.apps.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": true,
      "label": "t:sections.apps.settings.include_margins.label"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.apps.presets.name"
    }
  ]
}
{% endschema %}

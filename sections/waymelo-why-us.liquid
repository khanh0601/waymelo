{%- comment -%}
  Waymelo home page — "why choose us" band.

  Renders an optional eyebrow and centered section heading above a 2x2 grid of
  icon (left) + label & description (right) items matching the reference layout.
{%- endcomment -%}

{%- style -%}
  .wm-why-us {
    padding-block: clamp(40px, 5.5vw, 76px);
  }

  .wm-why-us__section-head {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .wm-why-us__head {
    text-align: center;
    max-width: 680px;
    margin-inline: auto;
  }

  .wm-why-us__heading {
    margin: 0;
    color: #1f1625;
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 3.4vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-align: center;
  }

  .wm-why-us__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 3.5vw, 46px) clamp(22px, 3.5vw, 50px);
    max-width: 960px;
    margin-inline: auto;
    margin-top: 0;
  }

  .wm-why-us__column {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 14px;
    min-width: 0;
  }

  .wm-why-us__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    color: #7a5168;
    margin-top: 2px;
  }

  .wm-why-us__icon.material-symbols-outlined,
  .wm-why-us__icon .material-symbols-outlined {
    font-size: 34px;
    line-height: 1;
    color: #7a5168;
  }

  .wm-why-us__icon-image {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .wm-why-us__icon-placeholder {
    width: 34px;
    height: 34px;
    border: 1px dashed var(--wm-line);
    border-radius: 4px;
  }

  .wm-why-us__content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .wm-why-us__label {
    margin: 0 0 6px;
    color: #1f1625;
    font-family: var(--font-heading-family);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .wm-why-us__text {
    margin: 0;
    color: #554e5b;
    font-size: 1.3rem;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .wm-why-us__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 14px;
    }

    .wm-why-us__column {
      gap: 10px;
    }

    .wm-why-us__icon {
      width: 28px;
      height: 28px;
      margin-top: 1px;
    }

    .wm-why-us__icon.material-symbols-outlined,
    .wm-why-us__icon .material-symbols-outlined {
      font-size: 26px;
    }

    .wm-why-us__icon-image {
      width: 26px;
      height: 26px;
    }

    .wm-why-us__label {
      font-size: 1.15rem;
      letter-spacing: 0.03em;
      margin-bottom: 4px;
      line-height: 1.2;
    }

    .wm-why-us__text {
      font-size: 1.05rem;
      line-height: 1.4;
    }
  }

  @media screen and (max-width: 380px) {
    .wm-why-us__grid {
      gap: 18px 10px;
    }

    .wm-why-us__column {
      gap: 8px;
    }

    .wm-why-us__icon {
      width: 24px;
      height: 24px;
    }

    .wm-why-us__icon.material-symbols-outlined,
    .wm-why-us__icon .material-symbols-outlined {
      font-size: 22px;
    }

    .wm-why-us__label {
      font-size: 1.05rem;
    }

    .wm-why-us__text {
      font-size: 0.95rem;
    }
  }
{%- endstyle -%}

<section
  class="wm-home wm-home__section wm-why-us"
  aria-labelledby="WaymeloWhyUsTitle-{{ section.id }}"
>
  <div class="wm-home__shell">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="wm-home__section-head wm-why-us__section-head">
        <div class="wm-why-us__head">
          {%- if section.settings.eyebrow != blank -%}
            <p class="wm-home__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="wm-home__heading wm-why-us__heading" id="WaymeloWhyUsTitle-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h2>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="wm-why-us__grid">
      {%- for block in section.blocks -%}
        <article class="wm-why-us__column" {{ block.shopify_attributes }}>
          <span class="wm-why-us__icon">
            {%- if block.settings.icon_image != blank -%}
              {{
                block.settings.icon_image
                | image_url: width: 120
                | image_tag: class: 'wm-why-us__icon-image', loading: 'lazy', alt: ''
              }}
            {%- elsif block.settings.icon != blank -%}
              <span class="material-symbols-outlined" aria-hidden="true">{{ block.settings.icon | escape }}</span>
            {%- else -%}
              <span class="wm-why-us__icon-placeholder" aria-hidden="true"></span>
            {%- endif -%}
          </span>

          <div class="wm-why-us__content">
            {%- if block.settings.heading != blank -%}
              <h3 class="wm-why-us__label">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="wm-why-us__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Waymelo why us",
  "tag": "section",
  "class": "section-waymelo-why-us",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Waymelo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Moms Choose Waymelo" },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Material icon name",
          "info": "A Material Symbols name, for example travel_explore, favorite, backpack or bolt. Ignored when a custom icon image is set, and shown as an empty slot when left blank.",
          "default": "verified"
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Reason to choose Waymelo" },
        { "type": "text", "id": "text", "label": "Description", "default": "What makes this reason matter." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Waymelo why us",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}

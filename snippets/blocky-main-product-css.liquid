{%- comment -%}
  Static rules live in assets/blocky-main-product.css (loaded in layout/theme.liquid on
  product pages). Only settings-driven values are rendered inline here.
{%- endcomment -%}
{%- unless request.page_type == 'product' -%}
  {{ 'blocky-main-product.css' | asset_url | stylesheet_tag }}
{%- endunless -%}
{% style %}
  #blocky-featured-product-{{ section.id }} {
    --background-color: {{ section.settings.background_color }};
    --padding-top: {{ section.settings.padding_top }};
    --padding-bottom: {{ section.settings.padding_bottom }};
    --section-page-width: {{ section.settings.page_width }}px;
    --text-container-gap: {{ section.settings.content_vertical_gap | default: 14 }}px;
    --bky-gap: {{ section.settings.content_gap }}px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media-wrap {
    border-radius: {{ section.settings.media_border_radius }}px;
    {% if section.settings.media_shadow %}box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);{% endif %}
    {% if section.settings.show_media_border %}border: 1px solid {{ section.settings.media_border_color }};{% endif %}
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media img,
  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media svg {
    object-fit: {{ section.settings.media_fit }};
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumbs--stack {
    grid-template-columns: repeat({{ section.settings.thumbnail_slides_per_column | default: 4 }}, minmax(0, 1fr));
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb {
    border: 1px solid {{ section.settings.thumbnail_border_color }};
    border-radius: {{ section.settings.thumbnail_border_radius }}px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb.is-active {
    border-color: {{ section.settings.thumbnail_active_border_color }};
  }

  @media screen and (min-width: 750px) {
    #blocky-featured-product-{{ section.id }} .blocky-featured-product__media-col {
      flex: 0 0 {{ section.settings.media_size }}%;
    }
  }

  @media screen and (max-width: 749px) {
    #blocky-featured-product-{{ section.id }} .blocky-flex-container {
      gap: {{ section.settings.mobile_content_gap }}px;
    }
  }
{% endstyle %}

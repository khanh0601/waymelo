{% style %}
  #blocky-featured-product-{{ section.id }} {
    --background-color: {{ section.settings.background_color }};
    --padding-top: {{ section.settings.padding_top }};
    --padding-bottom: {{ section.settings.padding_bottom }};
    --section-page-width: {{ section.settings.page_width }}px;
    --text-container-gap: {{ section.settings.content_vertical_gap | default: 14 }}px;
    --bky-gap: {{ section.settings.content_gap }}px;
    display: block;
    width: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-flex-container {
    gap: var(--bky-gap);
  }

  #blocky-featured-product-{{ section.id }} .blocky-flex-child {
    min-width: 0;
    flex: 1 1 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__content-col {
    display: flex;
    justify-content: center;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media-col {
    display: flex;
    justify-content: center;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media-col > div {
    width: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__content {
    justify-content: center;
    width: 100%;
    max-width: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__content > * {
    width: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.media_border_radius }}px;
    {% if section.settings.media_shadow %}box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);{% endif %}
    {% if section.settings.show_media_border %}border: 1px solid {{ section.settings.media_border_color }};{% endif %}
  }

  #blocky-featured-product-{{ section.id }} .blocky-media-adapt {
    aspect-ratio: var(--bky-media-ratio, 1);
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media-wrap::after,
  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-slider.is-loading .blocky-featured-product__thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, #f7f4f6 28%, #fdfcfd 44%, #f7f4f6 60%);
    background-size: 220% 100%;
    animation: blocky-loading-shimmer 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media-wrap::after {
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media-wrap.is-loading::after {
    opacity: 1;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__main {
    display: grid;
    grid-template-areas: "media";
    width: 100%;
    height: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media {
    display: none;
    grid-area: media;
    width: 100%;
    height: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media.is-active {
    display: block;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media img,
  #blocky-featured-product-{{ section.id }} .blocky-featured-product__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.media_fit }};
    background: rgba(0, 0, 0, 0.03);
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumbs {
    list-style: none;
    padding: 0;
    margin-top: 12px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumbs--stack {
    display: grid;
    grid-template-columns: repeat({{ section.settings.thumbnail_slides_per_column | default: 4 }}, minmax(0, 1fr));
    gap: 10px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-slider {
    position: relative;
    width: 100%;
    padding-inline: 0;
    overflow: visible;
    display: block;
    height: auto;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-slider .glide__track {
    width: 100%;
    overflow: hidden;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-slider .glide__slide {
    height: auto;
    width: var(--bky-thumb-width);
    margin-left: var(--bky-thumb-half-gap);
    margin-right: var(--bky-thumb-half-gap);
    flex-shrink: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-review__nav,
  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav{
    position: absolute;
    top: 50%;
    border: 0;
    background: transparent;
    color: currentColor;
    cursor: pointer;
    transform: translateY(-50%);
    font-size: 30px;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-review__nav--prev {
    left: 8px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-review__nav--next {
    right: 8px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav--prev {
    left: 0;
    transform: translate(-50%, -50%);
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav--next {
    right: 0;
    transform: translate(50%, -50%);
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav {
    z-index: 3;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: transparent;
    box-shadow: none;
    font-size: 0;
    transition: transform 0.18s ease;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid rgba(17, 24, 39, 0.1);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 2px 8px rgba(17, 24, 39, 0.14);
    backdrop-filter: blur(5px);
    transition: background-color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 7px;
    height: 7px;
    border-top: 1.75px solid #111827;
    border-right: 1.75px solid #111827;
    transition: border-color 0.18s ease;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav--prev::after {
    transform: translate(-35%, -50%) rotate(-135deg);
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav--next::after {
    transform: translate(-65%, -50%) rotate(45deg);
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav:hover {
    background: transparent;
    color: transparent;
    box-shadow: none;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav--prev:hover {
    transform: translate(-50%, -50%) scale(1.03);
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav--next:hover {
    transform: translate(50%, -50%) scale(1.03);
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav:hover::before {
    border-color: #111827;
    background: #111827;
    box-shadow: 0 3px 10px rgba(17, 24, 39, 0.22);
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav:hover::after {
    border-color: #ffffff;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav:focus-visible {
    outline: 2px solid #111827;
    outline-offset: 2px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-nav:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    background: transparent;
    border: 1px solid {{ section.settings.thumbnail_border_color }};
    border-radius: {{ section.settings.thumbnail_border_radius }}px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-slider.is-loading .blocky-featured-product__thumb::after {
    z-index: 1;
    border-radius: inherit;
  }

  #blocky-featured-product-{{ section.id }} .blocky-app-slot--pumper {
    position: relative;
    min-height: 520px;
    width: 100%;
    overflow: hidden;
  }

  @media screen and (max-width: 599px) {
    #blocky-featured-product-{{ section.id }} .blocky-app-slot--pumper {
      min-height: 580px;
    }
  }

  #blocky-featured-product-{{ section.id }} .blocky-app-slot--pumper.is-loading::before {
    content: '';
    position: absolute;
    inset: 16px 0;
    z-index: 2;
    border: 1px solid rgba(137, 84, 112, 0.08);
    border-radius: 20px;
    background:
      linear-gradient(#e9e0e5 0 0) 24px 26px / 38% 12px no-repeat,
      linear-gradient(#f1ebee 0 0) 24px 56px / calc(100% - 48px) 98px no-repeat,
      linear-gradient(#f1ebee 0 0) 24px 170px / calc(100% - 48px) 98px no-repeat,
      linear-gradient(#f1ebee 0 0) 24px 284px / calc(100% - 48px) 98px no-repeat,
      linear-gradient(#f1ebee 0 0) 24px 398px / calc(100% - 48px) 74px no-repeat,
      #fbf9fa;
    box-shadow: 0 10px 32px rgba(83, 51, 68, 0.04);
    animation: blocky-loading-breathe 1.8s ease-in-out infinite;
  }

  #blocky-featured-product-{{ section.id }} .blocky-app-slot--pumper.is-loading::after {
    content: '';
    position: absolute;
    inset: 16px 0;
    z-index: 3;
    border-radius: 20px;
    background: linear-gradient(105deg, transparent 36%, rgba(255, 255, 255, 0.72) 48%, transparent 60%);
    background-size: 220% 100%;
    pointer-events: none;
    animation: blocky-loading-shimmer 2.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  #blocky-featured-product-{{ section.id }} .blocky-app-slot--pumper.is-loading > .shopify-app-block {
    visibility: hidden;
    opacity: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-app-slot--pumper > .shopify-app-block {
    opacity: 1;
    transition: opacity 0.28s ease;
  }

  #blocky-featured-product-{{ section.id }} .blocky-pumper-highlight-label,
  #blocky-featured-product-{{ section.id }} .blocky-pumper-highlight-label * {
    color: #ffffff !important;
    opacity: 1 !important;
    font-weight: 600 !important;
    text-shadow: 0 1px 2px rgba(71, 20, 48, 0.24);
  }

  @media screen and (max-width: 749px) {
    #blocky-featured-product-{{ section.id }} .blocky-pumper-option-title {
      font-size: 16px !important;
      line-height: 1.22 !important;
      letter-spacing: normal !important;
      margin-inline-start: -4px !important;
    }

    #blocky-featured-product-{{ section.id }} .blocky-app-slot--pumper input[type='radio'] {
      width: 20px !important;
      min-width: 20px !important;
      height: 20px !important;
      min-height: 20px !important;
      flex: 0 0 20px !important;
      margin-inline-end: 0 !important;
    }

    #blocky-featured-product-{{ section.id }} .basic-tier-mount__header.svelte-15z07ky {
      gap: 18px !important;
    }
  }

  @keyframes blocky-loading-shimmer {
    from { background-position: 200% 0; }
    to { background-position: -200% 0; }
  }

  @keyframes blocky-loading-breathe {
    0%, 100% { opacity: 0.82; }
    50% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    #blocky-featured-product-{{ section.id }} .blocky-featured-product__media-wrap::after,
    #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb-slider.is-loading .blocky-featured-product__thumb::after,
    #blocky-featured-product-{{ section.id }} .blocky-app-slot--pumper.is-loading::before,
    #blocky-featured-product-{{ section.id }} .blocky-app-slot--pumper.is-loading::after {
      animation: none;
    }
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb.is-active {
    border-color: {{ section.settings.thumbnail_active_border_color }};
  }

  #blocky-featured-product-{{ section.id }} .blocky-featured-product__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #blocky-featured-product-{{ section.id }} .caption-with-letter-spacing {
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.8rem;
    color: var(--price-color);
    font-size: var(--price-size);
    font-weight: var(--price-weight);
    line-height: 1.2;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-price s {
    opacity: 0.55;
    font-size: 15px;
    font-weight: 400;
    color: var(--compare-price-color, var(--price-color));
  }

  #blocky-featured-product-{{ section.id }} .blocky-sale-badge {
    display: inline-flex;
    align-items: center;
    align-self: stretch;
    padding: 0 1.5rem;
    font-size: var(--bky-sale-badge-size, 12px);
    line-height: 1;
    font-weight: 400;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-inventory {
    display: flex;
    align-items: center;
    gap: 5px;
    margin: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-inventory.blocky-hidden {
    visibility: hidden;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-inventory__dot {
    flex-shrink: 0;
    width: 15px;
    height: 15px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-sku {
    margin: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-product-sku.blocky-hidden {
    visibility: hidden;
  }

  #blocky-featured-product-{{ section.id }} .blocky-visually-hidden {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    word-wrap: normal !important;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup__opener {
    display: inline-block;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup__button {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: text-decoration-thickness 0.1s ease;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup__button:hover {
    text-decoration-thickness: 2px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal {
    box-sizing: border-box;
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    margin: 0 auto;
    overflow: auto;
    opacity: 0;
    visibility: hidden;
    background: rgba(0, 0, 0, 0.2);
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal[open] {
    z-index: 2147483000;
    opacity: 1;
    visibility: visible;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal__content {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 92%;
    height: 80%;
    margin-top: 50px;
    padding: 0 15px 0 30px;
    overflow: auto;
    border-radius: 10px;
    background: #ffffff;
    color: #000000;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  @media screen and (min-width: 750px) {
    #blocky-featured-product-{{ section.id }} .blocky-popup-modal__content {
      width: 70%;
      margin-top: 100px;
      padding: 0 30px;
    }
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal__content img {
    max-width: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal__content-info {
    padding-right: 44px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal__content-info > * {
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal__toggle {
    display: flex;
    position: sticky;
    top: 15px;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin: 0 0 0 auto;
    padding: 12px;
    z-index: 2;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    background: #ffffff;
    color: rgba(0, 0, 0, 0.55);
    cursor: pointer;
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal__toggle:hover {
    color: rgba(0, 0, 0, 0.75);
  }

  #blocky-featured-product-{{ section.id }} .blocky-popup-modal__toggle svg {
    width: 22px;
    height: 22px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rating-wrapper {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rating {
    display: inline-block;
    margin: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rating-star {
    --letter-spacing: 0.8;
    --font-size: 1.7;
    --color-rating-star: currentColor;
    --percent: calc(
      (
          var(--rating) / var(--rating-max) + var(--rating-decimal) * var(--font-size) /
            (var(--rating-max) * (var(--letter-spacing) + var(--font-size)))
        ) * 100%
    );
    display: inline-block;
    font-family: Times, serif;
    font-size: calc(var(--font-size) * 10px);
    letter-spacing: calc(var(--letter-spacing) * 10px);
    line-height: 1;
    margin: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rating-star::before {
    content: '★★★★★';
    background: linear-gradient(
      90deg,
      var(--color-rating-star) var(--percent),
      rgba(128, 128, 128, 0.35) var(--percent)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  #blocky-featured-product-{{ section.id }} .blocky-rating-count {
    display: inline-block;
    margin: 0;
    font-size: 14px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share__button svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share__fallback {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share__fallback[hidden] {
    display: none;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share__input {
    flex: 1 1 200px;
    min-width: 0;
    padding: 8px 10px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    background: #ffffff;
    color: #000000;
    font: inherit;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share__copy {
    padding: 8px 12px;
    border: 1px solid currentColor;
    border-radius: 6px;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share__success {
    font-size: 13px;
  }

  #blocky-featured-product-{{ section.id }} .blocky-share__success[hidden] {
    display: none;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary {
    width: 100%;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary[hidden] {
    display: none;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__heading {
    margin: 0 0 12px;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary details {
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 0;
    cursor: pointer;
    list-style: none;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary summary::-webkit-details-marker {
    display: none;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__summary-title {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__summary-icon {
    flex-shrink: 0;
    font-family: 'Material Symbols Outlined';
    font-weight: normal;
    font-style: normal;
    font-size: 20px;
    line-height: 1;
    -webkit-font-smoothing: antialiased;
    font-feature-settings: 'liga';
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary__summary-caret {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  #blocky-featured-product-{{ section.id }} .blocky-complementary details[open] .blocky-complementary__summary-caret {

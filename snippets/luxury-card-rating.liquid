{% comment %}
  Renders rating for luxury collection card
  Accepts:
  - product: {Object} Product Liquid object
{% endcomment %}
{%- capture rating_markup -%}
  {% render 'card-product-rating', product: product, link: true %}
{%- endcapture -%}
{%- assign trimmed_rating = rating_markup | strip -%}
{%- if trimmed_rating != blank -%}
  <div class="card-product__rating-box">
    {{ rating_markup }}
  </div>
{%- endif -%}

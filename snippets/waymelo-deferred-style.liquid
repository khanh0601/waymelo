{%- comment -%}
  Defers non-critical product-page CSS until its section approaches the viewport.
  Usage: {% render 'waymelo-deferred-style', asset: 'component-card.css' %}
{%- endcomment -%}
{%- if request.page_type == 'product' -%}
  <link rel="stylesheet" data-waymelo-style="{{ asset | asset_url }}">
  <noscript>{{ asset | asset_url | stylesheet_tag }}</noscript>
{%- else -%}
  {{ asset | asset_url | stylesheet_tag }}
{%- endif -%}

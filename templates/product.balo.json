        "question_cLHAnz": {
          "type": "question",
          "settings": {
            "question": "2. How does the built-in changing station work?",
            "content": "<p>Open the expandable section, extend it according to the included instructions, and lay the changing pad flat on a stable surface at floor level. Keep changing supplies within reach and never leave your baby unattended. The station is intended for supervised diaper changes, not sleep.</p>",
            "default_open": false,

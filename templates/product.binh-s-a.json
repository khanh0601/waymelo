    "blocky_faq_cFeeU6": {
      "type": "blocky-faq",
      "blocks": {
        "question_CF8zA8": {
          "type": "question",
          "settings": {
            "question": "1. Can I use it to warm both milk and water?",
            "content": "<p>Yes. The warmer is designed for milk and water, with adjustable temperature settings. Select the appropriate setting and follow the included instructions for each type of liquid.</p>",
            "default_open": false,
            "icon_code": "",
            "icon_color": "#000000"
          }
        },
        "question_cLHAnz": {
          "type": "question",
          "settings": {
            "question": "2. What is the capacity of the warmer?",
            "content": "<p>The warmer holds up to 17 oz of liquid. Follow the maximum fill marking when filling, and prepare only the amount needed for your feeding routine.</p>",
            "default_open": false,
            "icon_code": "",
            "icon_color": "#000000"
          }
        },
        "question_LF7aE4": {
          "type": "question",
          "settings": {
            "question": "3. Does it need to stay plugged in during use?",
            "content": "<p>The rechargeable battery allows portable use without a continuous power connection. Battery life varies depending on the starting liquid temperature, selected setting, amount of liquid, and frequency of use.</p>",
            "default_open": false,
            "icon_code": "",
            "icon_color": "#000000"
          }
        },
        "question_KtVzDN": {
          "type": "question",
          "settings": {
            "question": "4. How do I use and clean the warmer?",
            "content": "<p>Charge the device, add milk or water within the fill limit, and select your desired temperature according to the included instructions. Check the liquid temperature before feeding. After use, switch off, allow it to cool, and clean the liquid-contact parts as directed. Keep the charging port dry and do not submerge the electronic components.</p>",
            "default_open": false,
            "icon_code": "",
            "icon_color": "#000000"
          }
        }
      },

        "collapsible_tab_pnakVM": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Product Details",
            "icon": "none",
            "heading_size": 16,
            "content": "<p></p><p><strong>Portable Changing Surface</strong><br/>The foldable changing pad provides a dedicated surface for diaper changes during outings, travel, and everyday use.</p><p><strong>Waterproof Changing Mat</strong><br/>The waterproof surface helps prevent moisture from passing through the mat and makes small messes easier to wipe away.</p><p><strong>Easy-Access Wipes Pocket</strong><br/>A dedicated wipes pocket allows access when the pad is open or folded. Insert your preferred wipes pack or a compatible reusable wipes pouch.</p><p><strong>Organized Storage</strong><br/>Two inner mesh pockets hold diapers and small changing essentials. An outer pocket provides additional space for parents’ personal items.</p><p><strong>Detachable Storage Section</strong><br/>The storage section can be detached when you only need the changing mat, giving you flexibility for different situations.</p><p><strong>Compact Carrying Design</strong><br/>Fold the pad closed between uses. The hook-and-loop straps and buckle loop offer convenient carrying and attachment options for a diaper bag or stroller.</p>",
            "content_size": 14,
            "page": "",
            "open_by_default": false,
            "bg_color": "",
            "text_color": "",
            "row_padding": 14,
            "letter_spacing": 0
          }
        },
        "collapsible_tab_VBrdmj": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "How To Use",
            "icon": "none",
            "heading_size": 16,
            "content": "<p><strong>1. Pack Your Supplies</strong><br/>Place diapers and changing essentials in the inner mesh pockets. Insert a compatible wipes pack into the wipes pocket with its opening aligned for easy access.</p><p><strong>2. Choose a Suitable Surface</strong><br/>Unfold the pad on a stable, flat surface, with the waterproof changing side facing upward. Keep supplies within reach before placing your baby down.</p><p><strong>3. Change Your Baby</strong><br/>Position your baby in the center of the mat and use the accessible wipes and supplies as needed. Keep your baby within arm’s reach and never leave them unattended.</p><p><strong>4. Clean After Each Use</strong><br/>Remove any waste and wipe the changing surface clean. Follow the product’s care instructions for cleaning products and washing methods.</p><p><strong>5. Dry and Fold</strong><br/>Allow the pad to dry completely, refill your supplies, and fold it closed. Fasten the closure before packing it away.</p><p><strong>6. Carry or Attach</strong><br/>Place the folded pad in your diaper bag or use the carrying loop. When attaching it to a stroller, follow the stroller manufacturer’s accessory guidelines.</p>",
            "content_size": 14,
            "page": "",

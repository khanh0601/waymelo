          "settings": {
            "question": "1. What can I store in the changing pad?",
            "content": "<p>Two inner mesh pockets hold diapers and small changing essentials, while an outer pocket provides space for personal items. The dedicated wipes pocket keeps wipes easily accessible.</p>",
            "default_open": false,
            "icon_code": "",
            "icon_color": "#000000"

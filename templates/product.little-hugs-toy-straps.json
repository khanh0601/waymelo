    "blocky_faq_cFeeU6": {
      "type": "blocky-faq",
      "blocks": {
        "question_CF8zA8": {
          "type": "question",
          "settings": {
            "question": "Is BabyEase safe to use?&nbsp;",
            "content": "<p>Yes, when used as intended and under <strong>constant adult supervision</strong>. Waymelo's Wearable Nursing Pillow is designed for feeding, cuddling, travel, and keeping your baby comfortable while they rest in your arms. Always keep your baby’s <strong>face and airway clear</strong>, and never use BabyEase as a car-seat replacement or safety restraint.</p>",
            "default_open": false,
            "icon_code": "",
            "icon_color": "#000000"
          }
        },
        "question_cLHAnz": {
          "type": "question",
          "settings": {
            "question": "Does BabyEase fit different body sizes?&nbsp;",
            "content": "<p>Yes. The adjustable neck strap lets you customize the fit and positioning for greater comfort.</p>",
            "default_open": false,
            "icon_code": "",
            "icon_color": "#000000"
          }
        },
        "question_LF7aE4": {
          "type": "question",
          "settings": {
            "question": "What can I use BabyEase for?&nbsp;",
            "content": "<p>BabyEase is designed for <strong>bottle feeding, breastfeeding, cuddling, relaxing, and travel</strong>. It helps support your baby while keeping them close and making longer holding sessions more comfortable.</p>",
            "default_open": false,
            "icon_code": "",
            "icon_color": "#000000"
          }
        },
        "question_KtVzDN": {
          "type": "question",
          "settings": {
            "question": "&nbsp;Why choose BabyEase over a regular pillow?",
            "content": "<p>A regular pillow can shift around and require constant adjusting. <strong>BabyEase’s curved shape and adjustable strap help keep the support in place</strong>, giving you a way more comfortable setup.</p>",
            "default_open": false,
            "icon_code": "",
            "icon_color": "#000000"
          }
        }
      },
